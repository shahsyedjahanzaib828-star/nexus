---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactEnquiryForm from '../components/ContactEnquiryForm.astro';
import { services } from '../data/services';
import {
	site,
	absoluteUrl,
	entityIds,
	organization,
	phoneHref,
	whatsappHref,
	mailHref
} from '../data/site';

const title = `Contact | ${site.name} in Karachi`;
const description = `Contact ${site.name} in ${site.city}, ${site.region}, ${site.country} by phone, WhatsApp, email, or the enquiry form for an initial consultation.`;
const canonical = absoluteUrl('/contact');

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ContactPage',
			'@id': `${canonical}#webpage`,
			'name': title,
			'description': description,
			'url': canonical,
			'isPartOf': { '@id': entityIds.website },
			'mainEntity': { '@id': entityIds.organization },
			'about': { '@id': entityIds.organization },
			'inLanguage': 'en-PK'
		}
	]
};

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Contact', href: '/contact' }
];
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	ogImage="/og/contact.png"
	ogImageAlt={`Contact ${site.name} in ${site.city}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#fbfaf8] text-[#252424] selection:bg-[#a83009] selection:text-white">
		<SiteHeader current="contact" />

		<main id="main-content">
			<section class="border-b border-[#e9e6e2] bg-[#f5f2ee]">
				<div class="mx-auto max-w-5xl px-5 py-16 lg:px-10 lg:py-24">
					<nav aria-label="Breadcrumb">
						<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">
							<li><a href="/" class="hover:text-[#0c0c0c]">Home</a></li>
							<li aria-hidden="true">/</li>
							<li class="text-[#4a4947]">Contact</li>
						</ol>
					</nav>
					<p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Get in touch</p>
					<h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.05] tracking-[-0.045em] text-[#0c0c0c] sm:text-6xl">
						Contact {site.name}
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-[#4a4947]">
						{organization.description}
					</p>
					<p class="mt-4 max-w-2xl text-base leading-7 text-[#696764]">
						Share a short summary of your matter by phone, WhatsApp, email, or the enquiry form. An initial enquiry does not create an advocate-client relationship.
					</p>
				</div>
			</section>

			<section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-[0.85fr_1.15fr] lg:px-10 lg:py-24" aria-labelledby="contact-methods-heading">
				<div>
					<h2 id="contact-methods-heading" class="text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c]">
						How to reach the practice
					</h2>
					<p class="mt-4 text-base leading-7 text-[#4a4947]">
						Location is stated at city level: {site.city}, {site.region}, {site.country}. A street-level office address is not published on this website.
					</p>

					<ul class="mt-8 space-y-3 text-sm text-[#696764]">
						<li>
							<a href={phoneHref} class="touch-target flex min-h-12 w-full items-center gap-3 rounded-xl px-2 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">
								<span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">☎</span>
								<span>
									<span class="block text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">Phone</span>
									<span class="font-semibold text-[#0c0c0c]">{site.phone}</span>
								</span>
							</a>
						</li>
						<li>
							<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="touch-target flex min-h-12 w-full items-center gap-3 rounded-xl px-2 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">
								<span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">◉</span>
								<span>
									<span class="block text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">WhatsApp</span>
									<span class="font-semibold text-[#0c0c0c]">WhatsApp consultation</span>
								</span>
							</a>
						</li>
						<li>
							<a href={mailHref} class="touch-target flex min-h-12 w-full items-center gap-3 rounded-xl px-2 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">
								<span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">@</span>
								<span>
									<span class="block text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">Email</span>
									<span class="font-semibold text-[#0c0c0c] break-all">{site.email}</span>
								</span>
							</a>
						</li>
						<li class="flex min-h-12 items-center gap-3 px-2 py-3">
							<span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">⌂</span>
							<span>
								<span class="block text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">Location</span>
								<span class="font-semibold text-[#0c0c0c]">{site.city}, {site.region}, {site.country}</span>
							</span>
						</li>
					</ul>

					<div class="mt-10">
						<h3 class="text-lg font-semibold text-[#0c0c0c]">Practice areas you can enquire about</h3>
						<ul class="mt-4 grid gap-2 sm:grid-cols-2">
							{services.map((service) => (
								<li>
									<a href={`/services/${service.slug}`} class="block rounded-xl border border-[#e9e6e2] bg-white px-4 py-3 text-sm font-semibold text-[#0c0c0c] hover:border-[#faac93]">
										{service.label}
									</a>
								</li>
							))}
						</ul>
						<p class="mt-4 text-sm text-[#696764]">
							<a href="/services" class="font-bold text-[#a83009] hover:text-[#0c0c0c]">View all practice areas ↗</a>
							{' · '}
							<a href="/about" class="font-bold text-[#a83009] hover:text-[#0c0c0c]">About the practice ↗</a>
						</p>
					</div>
				</div>

				<div>
					<h2 id="enquiry-form-heading" class="text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c]">
						Enquiry form
					</h2>
					<p class="mt-4 mb-6 text-base leading-7 text-[#4a4947]">
						Use this form to open a pre-filled email to the practice. Prefer WhatsApp or a phone call if that is easier for you.
					</p>
					<ContactEnquiryForm formId="contact-page-form" headingId="enquiry-form-heading" />
				</div>
			</section>

			<section class="border-t border-[#e9e6e2] bg-white" aria-labelledby="contact-disclaimer-heading">
				<div class="mx-auto max-w-5xl px-5 py-14 lg:px-10">
					<h2 id="contact-disclaimer-heading" class="text-2xl font-semibold text-[#0c0c0c]">Legal disclaimer</h2>
					<p class="mt-4 max-w-3xl text-sm leading-7 text-[#696764]">
						Website information is general information only and is not legal advice. Every matter is fact-specific. Calling, messaging, emailing, or submitting an enquiry through this website does not create an advocate-client relationship until engagement is formally agreed in writing. Results are not guaranteed.
					</p>
					<p class="mt-4 text-sm text-[#696764]">
						<a href="/privacy" class="font-bold text-[#a83009] hover:text-[#0c0c0c]">Privacy Policy</a>
						{' · '}
						<a href="/terms" class="font-bold text-[#a83009] hover:text-[#0c0c0c]">Terms of Use</a>
					</p>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
