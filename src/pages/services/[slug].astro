---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { services, type Service } from '../../data/services';
import { blogPosts } from '../../data/blog';
import { site, phoneHref, whatsappHref } from '../../data/site';

export function getStaticPaths() {
	return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const canonical = `${site.url}/services/${service.slug}`;
const relatedPosts = blogPosts.filter((post) => (service.related as readonly string[]).includes(post.slug));
const otherServices = services.filter((entry) => entry.slug !== service.slug);

const serviceSchema = {
	'@type': 'Service',
	'@id': `${canonical}#service`,
	'name': service.heading,
	'description': service.description,
	'url': canonical,
	'serviceType': service.label,
	'provider': { '@id': `${site.url}/#legal-service` },
	'areaServed': [
		{ '@type': 'City', name: site.city },
		{ '@type': 'State', name: site.region },
		{ '@type': 'Country', name: site.country }
	],
	'hasOfferCatalog': {
		'@type': 'OfferCatalog',
		'name': service.heading,
		'itemListElement': service.offerings.map((offering) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: offering } }))
	}
};
const faqSchema = {
	'@type': 'FAQPage',
	'mainEntity': service.faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
};
const schema = { '@context': 'https://schema.org', '@graph': [serviceSchema, faqSchema] };

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Practice Areas', href: '/services' },
	{ name: service.label, href: `/services/${service.slug}` }
];
---

<Layout
	title={service.seoTitle}
	description={service.description}
	canonical={canonical}
	ogImage={`/og/${service.slug}.png`}
	ogImageAlt={`${service.heading} — ${site.name}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<SiteHeader current="services" />

		<main id="main-content">
			<article>
				<header class="border-b border-[#dfe3d9] bg-[#edf1e8]">
					<div class="mx-auto max-w-5xl px-5 py-16 lg:px-10 lg:py-24">
						<nav aria-label="Breadcrumb">
							<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#487157]">
								{breadcrumbs.map((crumb, index) => (
									<li class="flex items-center gap-2">
										{index < breadcrumbs.length - 1
											? <a href={crumb.href} class="hover:text-[#163a2a]">{crumb.name}</a>
											: <span class="text-[#68736b]">{crumb.name}</span>}
										{index < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
									</li>
								))}
							</ol>
						</nav>
						<span class="mt-8 inline-flex items-center gap-3 rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#547000]">
							<span aria-hidden="true" class="text-base">{service.icon}</span>{service.label}
						</span>
						<h1 class="mt-6 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-0.045em] text-[#163a2a] sm:text-6xl">{service.heading}</h1>
						<p class="mt-8 max-w-3xl text-lg leading-8 text-[#3d4a42]">{service.intro}</p>
						<div class="mt-9 flex flex-wrap gap-4">
							<a href="/#contact" class="rounded-full bg-[#163a2a] px-6 py-3.5 text-sm font-bold text-white">Discuss your matter ↗</a>
							<a href={phoneHref} class="rounded-full border border-[#b8c3b6] px-5 py-3.5 text-sm font-bold text-[#163a2a]">Call {site.phone}</a>
						</div>
					</div>
				</header>

				<section class="border-b border-[#dfe3d9] bg-white">
					<div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-3 lg:px-10">
						<div>
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">01</p>
							<h2 class="mt-2 text-lg font-semibold text-[#163a2a]">Submit the facts</h2>
							<p class="mt-2 text-sm leading-6 text-[#4e5b53]">Share the situation, the documents you have, and any deadline already running.</p>
						</div>
						<div>
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">02</p>
							<h2 class="mt-2 text-lg font-semibold text-[#163a2a]">We assess the record</h2>
							<p class="mt-2 text-sm leading-6 text-[#4e5b53]">The position is reviewed on the papers, the forum and the realistic options — including where no filing is advisable.</p>
						</div>
						<div>
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">03</p>
							<h2 class="mt-2 text-lg font-semibold text-[#163a2a]">Agree the next step</h2>
							<p class="mt-2 text-sm leading-6 text-[#4e5b53]">Engagement is confirmed in writing before a matter is taken on. Outcomes are not guaranteed.</p>
						</div>
					</div>
				</section>

				<div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[240px_1fr] lg:px-10 lg:py-20">
					<aside class="h-fit space-y-6 lg:sticky lg:top-6">
						<div class="rounded-2xl border border-[#dfe3d9] bg-white p-5">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">On this page</p>
							<nav class="mt-4" aria-label="Table of contents">
								<ol class="space-y-3 text-sm leading-5 text-[#4e5b53]">
									{service.sections.map((section, index) => (
										<li><a class="hover:text-[#163a2a]" href={`#section-${index + 1}`}>{index + 1}. {section.heading}</a></li>
									))}
									<li><a class="hover:text-[#163a2a]" href="#faq">FAQs</a></li>
								</ol>
							</nav>
						</div>
						<div class="rounded-2xl border border-[#dfe3d9] bg-white p-5">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">Other practice areas</p>
							<ul class="mt-4 space-y-3 text-sm leading-5 text-[#4e5b53]">
								{otherServices.map((entry) => (
									<li><a class="hover:text-[#163a2a]" href={`/services/${entry.slug}`}>{entry.label}</a></li>
								))}
							</ul>
						</div>
					</aside>

					<div class="min-w-0 max-w-3xl">
						<section class="rounded-3xl border border-[#dfe3d9] bg-white p-6 sm:p-8">
							<h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[#487157]">Services covered</h2>
							<ul class="mt-5 grid gap-3 sm:grid-cols-2">
								{service.offerings.map((offering) => (
									<li class="flex gap-2 text-sm leading-6 text-[#4e5b53]"><span class="text-[#789400]">+</span><span>{offering}</span></li>
								))}
							</ul>
						</section>

						{service.sections.map((section, index) => (
							<section id={`section-${index + 1}`} class="scroll-mt-8 border-b border-[#e1e5dd] pb-10 pt-10 last:border-0">
								<h2 class="text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#163a2a]">{section.heading}</h2>
								{section.paragraphs.map((paragraph) => <p class="mt-5 text-base leading-8 text-[#3d4a42]">{paragraph}</p>)}
								{'points' in section && section.points && (
									<div class="mt-6 rounded-2xl bg-[#edf1e8] p-5">
										<h3 class="text-sm font-bold uppercase tracking-[0.14em] text-[#487157]">Practical points</h3>
										<ul class="mt-4 space-y-3">
											{section.points.map((point) => (
												<li class="flex gap-3 text-sm leading-6 text-[#4e5b53]"><span class="text-[#789400]">+</span><span>{point}</span></li>
											))}
										</ul>
									</div>
								)}
							</section>
						))}

						<section id="faq" class="scroll-mt-8 border-t border-[#dfe3d9] pt-10">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Frequently asked questions</p>
							<h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] text-[#163a2a]">{service.label} questions clients ask</h2>
							<div class="mt-7 space-y-4">
								{service.faq.map(([question, answer]) => (
									<details class="group rounded-2xl border border-[#dfe3d9] bg-white p-5">
										<summary class="cursor-pointer list-none pr-6 text-base font-semibold text-[#163a2a] marker:hidden">
											{question}<span class="float-right text-[#789400] group-open:rotate-45">+</span>
										</summary>
										<p class="mt-4 text-sm leading-7 text-[#4e5b53]">{answer}</p>
									</details>
								))}
							</div>
						</section>

						{relatedPosts.length > 0 && (
							<section class="mt-12 border-t border-[#dfe3d9] pt-10">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Related reading</p>
								<h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] text-[#163a2a]">Detailed guides on this topic</h2>
								<div class="mt-6 grid gap-4 sm:grid-cols-2">
									{relatedPosts.map((post) => (
										<a href={`/blog/${post.slug}`} class="flex flex-col items-start rounded-2xl border border-[#dfe3d9] bg-white p-5 hover:-translate-y-0.5 hover:border-[#a9ba57]">
											<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#789400]">{post.label}</span>
											<span class="mt-3 text-base font-semibold leading-snug text-[#163a2a]">{post.title}</span>
											<span class="mt-3 text-xs font-semibold text-[#547000]">Read article ↗</span>
										</a>
									))}
								</div>
							</section>
						)}

						<section class="mt-12 rounded-3xl bg-[#163a2a] p-7 text-white sm:p-9">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">Need advice on your situation?</p>
							<h2 class="mt-3 max-w-xl text-3xl font-semibold leading-tight">Professional legal consultation.</h2>
							<p class="mt-4 max-w-xl text-sm leading-6 text-[#c4d0c5]">Discuss your matter confidentially with a {site.city}-based legal practitioner and corporate consultant.</p>
							<div class="mt-7 flex flex-wrap gap-3">
								<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#d5e767] px-5 py-3 text-sm font-bold text-[#163a2a]">WhatsApp {site.phone} ↗</a>
								<a href={phoneHref} class="rounded-full border border-white/25 px-5 py-3 text-sm font-bold text-white">Call now</a>
							</div>
						</section>
					</div>
				</div>
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
