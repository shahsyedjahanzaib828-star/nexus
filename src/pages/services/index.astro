---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { services } from '../../data/services';
import { site, phoneHref, whatsappHref } from '../../data/site';

const title = 'Legal Services in Karachi | Litigation, Corporate & Tax';
const description =
	'Legal services in Karachi: civil, criminal and family litigation, property and SBCA matters, SECP registration, FBR tax filing, WeBOC and trademarks.';
const canonical = `${site.url}/services`;

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'name': title,
			'description': description,
			'url': canonical,
			'isPartOf': { '@id': `${site.url}/#website` }
		},
		{
			'@type': 'ItemList',
			'name': 'Practice areas',
			'itemListElement': services.map((service, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: service.heading,
				url: `${site.url}/services/${service.slug}`
			}))
		}
	]
};

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Practice Areas', href: '/services' }
];
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	ogImage="/og/services.png"
	ogImageAlt={`Legal practice areas at ${site.name}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<SiteHeader current="services" />

		<main id="main-content">
			<section class="border-b border-[#dfe3d9] bg-[#edf1e8]">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#487157]">{site.city} · {site.region} · {site.country}</p>
					<h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.02] tracking-[-0.05em] text-[#163a2a] sm:text-6xl">
						Legal services for <span class="text-[#547000]">individuals and businesses.</span>
					</h1>
					<p class="mt-8 max-w-3xl text-lg leading-8 text-[#3d4a42]">
						Six practice areas covering litigation, property, corporate structuring, tax compliance, international trade and intellectual property. Each area is handled with the same approach: establish the documents and the legal position first, then act.
					</p>
					<div class="mt-9 flex flex-wrap gap-4">
						<a href="/#contact" class="rounded-full bg-[#163a2a] px-6 py-3.5 text-sm font-bold text-white">Discuss your matter ↗</a>
						<a href={phoneHref} class="rounded-full border border-[#b8c3b6] px-5 py-3.5 text-sm font-bold text-[#163a2a]">Call {site.phone}</a>
					</div>
				</div>
			</section>

			<section class="border-b border-[#dfe3d9] bg-white">
				<div class="mx-auto grid max-w-7xl gap-4 px-5 py-12 md:grid-cols-2 lg:px-10">
					<article class="rounded-3xl border border-[#dfe3d9] bg-[#fbfcf9] p-6">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">Court work</p>
						<h2 class="mt-3 text-2xl font-semibold text-[#163a2a]">The matter is already in dispute.</h2>
						<p class="mt-3 text-sm leading-6 text-[#4e5b53]">FIR, family petition, civil suit, property possession or a High Court writ. The first task is the record, the forum and any deadline already running.</p>
						<a href="/services/litigation-lawyer-karachi" class="mt-6 text-sm font-bold text-[#547000]">Litigation services ↗</a>
					</article>
					<article class="rounded-3xl border border-[#dfe3d9] bg-[#fbfcf9] p-6">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">Filings and compliance</p>
						<h2 class="mt-3 text-2xl font-semibold text-[#163a2a]">The business still has to be set up correctly.</h2>
						<p class="mt-3 text-sm leading-6 text-[#4e5b53]">SECP incorporation, FBR and SRB returns, WeBOC access, SBCA papers or an IPO trademark. Sequence and consistent particulars matter more than speed.</p>
						<a href="/services/secp-company-registration-karachi" class="mt-6 text-sm font-bold text-[#547000]">Company and tax services ↗</a>
					</article>
				</div>
			</section>

			<section class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24">
				<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{services.map((service) => (
						<article class="group flex flex-col rounded-3xl border border-[#dfe3d9] bg-white p-6 hover:-translate-y-1 hover:border-[#a9ba57] hover:shadow-lg">
							<div class="flex items-start justify-between">
								<span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#e6f0d4] text-xl font-semibold text-[#547000]" aria-hidden="true">{service.icon}</span>
								<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#789400]">{service.label}</span>
							</div>
							<h2 class="mt-8 text-xl font-semibold leading-tight text-[#163a2a]">
								<a href={`/services/${service.slug}`} class="hover:text-[#547000]">{service.heading}</a>
							</h2>
							<p class="mt-4 text-sm leading-6 text-[#4e5b53]">{service.description}</p>
							<ul class="mt-6 space-y-3 border-t border-[#e5e8e1] pt-5">
								{service.offerings.slice(0, 3).map((offering) => (
									<li class="flex gap-2 text-sm leading-5 text-[#4e5b53]"><span class="text-[#789400]">+</span><span>{offering}</span></li>
								))}
							</ul>
							<a href={`/services/${service.slug}`} class="mt-6 text-sm font-bold text-[#547000] group-hover:text-[#163a2a]">
								View {service.label.toLowerCase()} services <span aria-hidden="true">↗</span>
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="border-y border-[#dfe3d9] bg-[#163a2a] text-white">
				<div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-14 sm:flex-row sm:items-center sm:justify-between lg:px-10">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">Have a matter to discuss?</p>
						<h2 class="mt-3 text-3xl font-semibold tracking-tight">A clear next step starts with a conversation.</h2>
					</div>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#d5e767] px-6 py-3.5 text-center text-sm font-bold text-[#163a2a]">Consult now ↗</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
