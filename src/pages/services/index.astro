---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { services } from '../../data/services';
import { site, absoluteUrl, entityIds, phoneHref, whatsappHref } from '../../data/site';

const title = 'Legal Services in Karachi | Litigation, Corporate & Tax';
const description =
	'Legal services in Karachi: civil, criminal and family litigation, property and SBCA matters, SECP registration, FBR tax filing, WeBOC and trademarks.';
const canonical = absoluteUrl('/services');

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'name': title,
			'description': description,
			'url': canonical,
			'isPartOf': { '@id': entityIds.website },
			'about': { '@id': entityIds.organization },
			'provider': { '@id': entityIds.organization }
		},
		{
			'@type': 'ItemList',
			'name': 'Practice areas',
			'itemListElement': services.map((service, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: service.heading,
				url: absoluteUrl(`/services/${service.slug}`)
			}))
		}
	]
};

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Practice Areas', href: '/services' }
];
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	ogImage="/og/services.png"
	ogImageAlt={`Legal practice areas at ${site.name}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#fbfaf8] text-[#252424] selection:bg-[#a83009] selection:text-white">
		<SiteHeader current="services" />

		<main id="main-content">
			<section class="border-b border-[#e9e6e2] bg-[#f5f2ee]">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">{site.city} · {site.region} · {site.country}</p>
					<h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.02] tracking-[-0.05em] text-[#0c0c0c] sm:text-6xl">
						Legal services in {site.city} for <span class="text-[#a83009]">individuals and businesses.</span>
					</h1>
					<p class="mt-8 max-w-3xl text-lg leading-8 text-[#4a4947]">
						Six practice areas covering litigation, property, corporate structuring, tax compliance, international trade and intellectual property. Each area is handled with the same approach: establish the documents and the legal position first, then act.
					</p>
					<div class="mt-9 flex flex-wrap gap-4">
						<a href="/contact" class="rounded-full bg-[#0c0c0c] px-6 py-3.5 text-sm font-bold text-white">Discuss your matter ↗</a>
						<a href={phoneHref} class="rounded-full border border-[#c4c2be] px-5 py-3.5 text-sm font-bold text-[#0c0c0c]">Call {site.phone}</a>
					</div>
				</div>
			</section>

			<section class="border-b border-[#e9e6e2] bg-white">
				<div class="mx-auto grid max-w-7xl gap-4 px-5 py-12 md:grid-cols-2 lg:px-10">
					<article class="rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">Court work</p>
						<h2 class="mt-3 text-2xl font-semibold text-[#0c0c0c]">The matter is already in dispute.</h2>
						<p class="mt-3 text-sm leading-6 text-[#696764]">FIR, family petition, civil suit, property possession or a High Court writ. The first task is the record, the forum and any deadline already running.</p>
						<a href="/services/litigation-lawyer-karachi" class="mt-6 text-sm font-bold text-[#a83009]">Litigation services ↗</a>
					</article>
					<article class="rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">Filings and compliance</p>
						<h2 class="mt-3 text-2xl font-semibold text-[#0c0c0c]">FBR return filing and business setup.</h2>
						<p class="mt-3 text-sm leading-6 text-[#696764]">FBR and SRB returns, SECP incorporation, WeBOC access, SBCA papers or an IPO trademark. Sequence and consistent particulars matter more than speed.</p>
						<a href="/services/fbr-tax-filing-services-karachi" class="mt-6 text-sm font-bold text-[#a83009]">FBR tax filing services ↗</a>
					</article>
				</div>
			</section>

			<section class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24">
				<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{services.map((service) => (
						<article class="group flex flex-col rounded-3xl border border-[#e9e6e2] bg-white p-6 hover:-translate-y-1 hover:border-[#faac93] hover:shadow-lg">
							<div class="flex items-start justify-between">
								<span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#fef5f2] text-xl font-semibold text-[#a83009]" aria-hidden="true">{service.icon}</span>
								<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">{service.label}</span>
							</div>
							<h2 class="mt-8 text-xl font-semibold leading-tight text-[#0c0c0c]">
								<a href={`/services/${service.slug}`} class="hover:text-[#a83009]">{service.heading}</a>
							</h2>
							<p class="mt-4 text-sm leading-6 text-[#696764]">{service.description}</p>
							<ul class="mt-6 space-y-3 border-t border-[#e9e6e2] pt-5">
								{service.offerings.slice(0, 3).map((offering) => (
									<li class="flex gap-2 text-sm leading-5 text-[#696764]"><span class="text-[#a83009]">+</span><span>{offering}</span></li>
								))}
							</ul>
							<a href={`/services/${service.slug}`} class="mt-6 text-sm font-bold text-[#a83009] group-hover:text-[#0c0c0c]">
								View {service.label.toLowerCase()} services <span aria-hidden="true">↗</span>
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="border-y border-[#e9e6e2] bg-[#0c0c0c] text-white">
				<div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-14 sm:flex-row sm:items-center sm:justify-between lg:px-10">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#f45a27]">Have a matter to discuss?</p>
						<h2 class="mt-3 text-3xl font-semibold tracking-tight">A clear next step starts with a conversation.</h2>
					</div>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#a83009] px-6 py-3.5 text-center text-sm font-bold text-white">Consult now ↗</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
