---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { services } from '../../data/services';
import { practiceAreaServices, businessServices } from '../../data/navigation';
import { site, absoluteUrl, entityIds, phoneHref, whatsappHref } from '../../data/site';

const title = 'Legal Services in Karachi | Litigation, Corporate & Tax';
const description =
	'Legal services in Karachi: civil, criminal and family litigation, property and SBCA matters, SECP registration, FBR tax filing, WeBOC and trademarks.';
const canonical = absoluteUrl('/services');

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage',
			'@id': `${canonical}#webpage`,
			'name': title,
			'description': description,
			'url': canonical,
			'isPartOf': { '@id': entityIds.website },
			'about': { '@id': entityIds.organization }
		},
		{
			'@type': 'ItemList',
			'name': 'Practice areas',
			'itemListElement': services.map((service, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: service.heading,
				url: absoluteUrl(`/services/${service.slug}`)
			}))
		}
	]
};

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Services', href: '/services' }
];
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	ogImage="/og/services.png"
	ogImageAlt={`Legal practice areas at ${site.name}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#fbfaf8] text-[#252424] selection:bg-[#a83009] selection:text-white">
		<SiteHeader current="services" />

		<main id="main-content">
			<section class="border-b border-[#e9e6e2] bg-[#f5f2ee]">
				<div class="mx-auto max-w-7xl px-5 py-10 lg:px-10 lg:py-14">
					<nav aria-label="Breadcrumb">
						<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">
							<li><a href="/" class="hover:text-[#0c0c0c]">Home</a></li>
							<li aria-hidden="true">/</li>
							<li class="text-[#4a4947]">Services</li>
						</ol>
					</nav>
					<p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">{site.city} · {site.region} · {site.country}</p>
					<h1 class="type-page-title mt-4 max-w-4xl font-semibold text-[#0c0c0c]">
						Legal services in {site.city} for <span class="text-[#a83009]">individuals and businesses.</span>
					</h1>
					<p class="mt-8 max-w-3xl text-lg leading-8 text-[#4a4947]">
						Six practice areas covering litigation, property, corporate structuring, tax compliance, international trade and intellectual property. Each area is handled with the same approach: establish the documents and the legal position first, then act.
					</p>
					<div class="mt-9 flex flex-wrap gap-4">
						<a href="/contact" class="touch-target rounded-full bg-[#0c0c0c] px-6 py-3.5 text-sm font-bold text-white">Discuss your matter ↗</a>
						<a href={phoneHref} class="touch-target rounded-full border border-[#c4c2be] px-5 py-3.5 text-sm font-bold text-[#0c0c0c]">Call {site.phone}</a>
					</div>
				</div>
			</section>

			<section id="practice-areas" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-8 lg:px-8 lg:py-10">
				<h2 class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">Practice areas</h2>
				<div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{practiceAreaServices.map((service) => (
						<article class="group flex flex-col rounded-2xl border border-[#e9e6e2] bg-white p-5 hover:border-[#faac93]">
							<div class="flex items-start justify-between">
								<span class="grid h-10 w-10 place-items-center rounded-xl bg-[#fef5f2] text-lg font-semibold text-[#a83009]" aria-hidden="true">{service.icon}</span>
								<span class="text-xs font-bold uppercase tracking-[0.12em] text-[#a83009]">{service.label}</span>
							</div>
							<h3 class="mt-4 text-lg font-semibold leading-tight text-[#0c0c0c]">
								<a href={`/services/${service.slug}`} class="touch-target inline min-h-12 py-1 hover:text-[#a83009]">{service.heading}</a>
							</h3>
							<p class="mt-2 text-sm leading-6 text-[#696764]">{service.description}</p>
							<a href={`/services/${service.slug}`} class="touch-target mt-4 min-h-12 text-sm font-bold text-[#a83009]">
								View {service.label.toLowerCase()} ↗
							</a>
						</article>
					))}
				</div>

				<h2 id="business-services" class="mt-10 scroll-mt-24 text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">Business services</h2>
				<div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{businessServices.map((service) => (
						<article class="group flex flex-col rounded-2xl border border-[#e9e6e2] bg-[#fbfaf8] p-5 hover:border-[#faac93]">
							<div class="flex items-start justify-between">
								<span class="grid h-10 w-10 place-items-center rounded-xl bg-[#fef5f2] text-lg font-semibold text-[#a83009]" aria-hidden="true">{service.icon}</span>
								<span class="text-xs font-bold uppercase tracking-[0.12em] text-[#a83009]">{service.label}</span>
							</div>
							<h3 class="mt-4 text-lg font-semibold leading-tight text-[#0c0c0c]">
								<a href={`/services/${service.slug}`} class="touch-target inline min-h-12 py-1 hover:text-[#a83009]">{service.heading}</a>
							</h3>
							<p class="mt-2 text-sm leading-6 text-[#696764]">{service.description}</p>
							<a href={`/services/${service.slug}`} class="touch-target mt-4 min-h-12 text-sm font-bold text-[#a83009]">
								View {service.label.toLowerCase()} ↗
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="border-y border-[#e9e6e2] bg-[#0c0c0c] text-white">
				<div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-14 sm:flex-row sm:items-center sm:justify-between lg:px-10">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#f45a27]">Have a matter to discuss?</p>
						<h2 class="mt-3 text-3xl font-semibold tracking-tight">A clear next step starts with a conversation.</h2>
					</div>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#a83009] px-6 py-3.5 text-center text-sm font-bold text-white">Consult now ↗</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
