---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, absoluteUrl, entityIds, mailHref } from '../data/site';

const title = `Privacy Policy | ${site.name}`;
const description = `Privacy policy explaining how ${site.name} handles enquiries and information submitted through this website.`;
const canonical = absoluteUrl('/privacy');

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': `${canonical}#webpage`,
			'name': title,
			'description': description,
			'url': canonical,
			'isPartOf': { '@id': entityIds.website },
			'about': { '@id': entityIds.organization },
			'inLanguage': 'en-PK'
		}
	]
};

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Privacy Policy', href: '/privacy' }
];
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	ogImage="/og/privacy.png"
	ogImageAlt={`Privacy Policy — ${site.name}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#fbfaf8] text-[#252424]">
		<SiteHeader />

		<main id="main-content" class="px-5 py-10 lg:px-10 lg:py-14">
			<article class="mx-auto max-w-3xl">
				<nav aria-label="Breadcrumb">
					<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">
						<li><a href="/" class="hover:text-[#0c0c0c]">Home</a></li>
						<li aria-hidden="true">/</li>
						<li class="text-[#4a4947]">Privacy Policy</li>
					</ol>
				</nav>
				<p class="mt-10 text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Privacy and information handling</p>
				<h1 class="type-page-title mt-4 font-semibold text-[#0c0c0c]">Privacy Policy</h1>
				<p class="mt-6 text-base leading-7 text-[#252424]">This policy explains how {site.name} ({site.city}, {site.region}, {site.country}) handles information submitted through this website. It is general website information and does not create an advocate-client relationship.</p>
				<div class="mt-12 space-y-10 text-base leading-7 text-[#696764]">
					<section>
						<h2 class="text-2xl font-semibold text-[#0c0c0c]">Information you provide</h2>
						<p class="mt-3">If you use the enquiry form or contact the practice by phone, WhatsApp, or email, you may provide your name, phone number, email address, city, service interest, and case summary. Please do not send highly sensitive documents or confidential facts until a consultation and engagement process has been agreed.</p>
					</section>
					<section>
						<h2 class="text-2xl font-semibold text-[#0c0c0c]">How information is used</h2>
						<p class="mt-3">Information is used to respond to enquiries, assess requested services, arrange communication, maintain basic business records, and comply with legal or professional obligations. It is not sold for advertising.</p>
					</section>
					<section>
						<h2 class="text-2xl font-semibold text-[#0c0c0c]">No automatic advocate-client relationship</h2>
						<p class="mt-3">Submitting the website enquiry form, sending an email, calling, or messaging on WhatsApp does not by itself create an advocate-client relationship. Engagement is confirmed in writing before a matter is taken on.</p>
					</section>
					<section>
						<h2 class="text-2xl font-semibold text-[#0c0c0c]">Email and third-party services</h2>
						<p class="mt-3">The enquiry form uses your email application to send a message. WhatsApp links open a third-party service governed by its own privacy terms. Website hosting and delivery may also involve service providers that process technical request data.</p>
					</section>
					<section>
						<h2 class="text-2xl font-semibold text-[#0c0c0c]">Retention and security</h2>
						<p class="mt-3">Information is retained only as reasonably necessary for the purpose for which it was provided, legal obligations, dispute prevention, or professional record keeping. No online transmission can be guaranteed completely secure.</p>
					</section>
					<section>
						<h2 class="text-2xl font-semibold text-[#0c0c0c]">Your questions</h2>
						<p class="mt-3">For privacy questions or to request clarification about an enquiry, contact <a class="font-semibold text-[#a83009]" href={mailHref}>{site.email}</a> or call <a class="font-semibold text-[#a83009]" href={`tel:+92${site.phone.slice(1)}`}>{site.phone}</a>.</p>
					</section>
				</div>
				<p class="mt-12 border-t border-[#e9e6e2] pt-6 text-sm leading-6 text-[#252424]">
					Last updated: 28 August 2026. This policy may be updated when the website, services, or applicable requirements change.
					{' '}
					<a class="font-semibold text-[#a83009]" href="/about">About the practice</a>
					{' · '}
					<a class="font-semibold text-[#a83009]" href="/contact">Contact</a>
					{' · '}
					<a class="font-semibold text-[#a83009]" href="/terms">Terms of Use</a>
				</p>
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
