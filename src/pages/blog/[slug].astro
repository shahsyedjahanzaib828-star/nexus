---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { blogPosts, type BlogPost } from '../../data/blog';
import { services } from '../../data/services';
import { site, phoneHref, whatsappHref } from '../../data/site';

export function getStaticPaths() {
	return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const canonical = `${site.url}/blog/${post.slug}`;

// Services that reference this article, so each post links back to the practice area it supports.
const relatedServices = services.filter((service) => (service.related as readonly string[]).includes(post.slug));
const otherPosts = blogPosts.filter((entry) => entry.slug !== post.slug).slice(0, 3);

const articleSchema = {
	'@type': 'BlogPosting',
	'@id': `${canonical}#article`,
	'headline': post.title,
	'description': post.description,
	'url': canonical,
	'datePublished': post.date,
	'dateModified': post.date,
	'inLanguage': 'en-PK',
	'wordCount': post.sections.reduce((total, section) => total + section.paragraphs.join(' ').split(/\s+/).length, 0),
	'author': { '@id': `${site.url}/#professional` },
	'publisher': { '@id': `${site.url}/#legal-service` },
	'mainEntityOfPage': canonical,
	'image': `${site.url}/og/${post.slug}.png`,
	'about': [`Legal services in ${site.city}`, `${site.country} business law`, post.label]
};
const faqSchema = {
	'@type': 'FAQPage',
	'mainEntity': post.faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
};
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema] };

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Blog', href: '/blog' },
	{ name: post.label, href: `/blog/${post.slug}` }
];
---

<Layout
	title={post.seoTitle}
	description={post.description}
	canonical={canonical}
	ogImage={`/og/${post.slug}.png`}
	ogImageAlt={`${post.title} — ${site.name}`}
	schema={schema}
	type="article"
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<SiteHeader current="blog" />

		<main id="main-content">
			<article>
				<header class="border-b border-[#dfe3d9] bg-[#edf1e8]">
					<div class="mx-auto max-w-4xl px-5 py-16 lg:px-10 lg:py-24">
						<nav aria-label="Breadcrumb">
							<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#487157]">
								<li><a href="/" class="hover:text-[#163a2a]">Home</a></li>
								<li aria-hidden="true">/</li>
								<li><a href="/blog" class="hover:text-[#163a2a]">Blog</a></li>
								<li aria-hidden="true">/</li>
								<li class="text-[#68736b]">{post.label}</li>
							</ol>
						</nav>
						<p class="mt-10 text-xs font-bold uppercase tracking-[0.2em] text-[#487157]">{post.label} · {post.readingTime}</p>
						<h1 class="mt-5 text-3xl font-semibold leading-[1.08] tracking-[-0.04em] text-[#163a2a] sm:text-5xl lg:text-7xl">{post.title}</h1>
						<p class="mt-8 max-w-3xl text-xl leading-8 text-[#3d4a42]">{post.intro}</p>
						<div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-[#4e5b53]">
							<span>By <a href="/about" class="font-bold text-[#163a2a] hover:text-[#547000]">Jahanzaib</a></span>
							<span aria-hidden="true">·</span>
							<time datetime={post.date}>{post.date}</time>
						</div>
					</div>
				</header>

				<div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[240px_1fr] lg:px-10 lg:py-24">
					<aside class="h-fit space-y-6 lg:sticky lg:top-6">
						<div class="rounded-2xl border border-[#dfe3d9] bg-white p-5">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">In this article</p>
							<nav class="mt-4" aria-label="Table of contents">
								<ol class="space-y-3 text-sm leading-5 text-[#4e5b53]">
									{post.sections.map((section, index) => (
										<li><a class="hover:text-[#163a2a]" href={`#section-${index + 1}`}>{index + 1}. {section.heading}</a></li>
									))}
									<li><a class="hover:text-[#163a2a]" href="#faq">FAQs</a></li>
								</ol>
							</nav>
						</div>
						{relatedServices.length > 0 && (
							<div class="rounded-2xl border border-[#dfe3d9] bg-white p-5">
								<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">Related service</p>
								<ul class="mt-4 space-y-3 text-sm leading-5 text-[#4e5b53]">
									{relatedServices.map((service) => (
										<li><a class="font-semibold text-[#547000] hover:text-[#163a2a]" href={`/services/${service.slug}`}>{service.label} ↗</a></li>
									))}
								</ul>
							</div>
						)}
					</aside>

					<div class="min-w-0">
						<div class="prose-like max-w-3xl">
							{post.sections.map((section, index) => (
								<section id={`section-${index + 1}`} class="scroll-mt-8 border-b border-[#e1e5dd] pb-10 pt-2 first:pt-0 last:border-0">
									<h2 class="text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#163a2a]">{section.heading}</h2>
									{section.paragraphs.map((paragraph) => <p class="mt-5 text-base leading-8 text-[#3d4a42]">{paragraph}</p>)}
									{section.points && (
										<div class="mt-6 rounded-2xl bg-[#edf1e8] p-5">
											<h3 class="text-sm font-bold uppercase tracking-[0.14em] text-[#487157]">Risk points to discuss</h3>
											<ul class="mt-4 space-y-3">
												{section.points.map((point) => (
													<li class="flex gap-3 text-sm leading-6 text-[#4e5b53]"><span class="text-[#789400]">+</span><span>{point}</span></li>
												))}
											</ul>
										</div>
									)}
								</section>
							))}
						</div>

						<section id="faq" class="scroll-mt-8 border-t border-[#dfe3d9] pt-10">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Frequently asked questions</p>
							<h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] text-[#163a2a]">Questions {site.city} clients often ask</h2>
							<div class="mt-7 space-y-4">
								{post.faq.map(([question, answer]) => (
									<details class="group rounded-2xl border border-[#dfe3d9] bg-white p-5">
										<summary class="cursor-pointer list-none pr-6 text-base font-semibold text-[#163a2a] marker:hidden">
											{question}<span class="float-right text-[#789400] group-open:rotate-45">+</span>
										</summary>
										<p class="mt-4 text-sm leading-7 text-[#4e5b53]">{answer}</p>
									</details>
								))}
							</div>
						</section>

						{relatedServices.length > 0 && (
							<section class="mt-12 border-t border-[#dfe3d9] pt-10">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">How this practice can help</p>
								<div class="mt-6 grid gap-4 sm:grid-cols-2">
									{relatedServices.map((service) => (
										<a href={`/services/${service.slug}`} class="flex flex-col items-start rounded-2xl border border-[#dfe3d9] bg-white p-5 hover:-translate-y-0.5 hover:border-[#a9ba57]">
											<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#789400]">{service.label}</span>
											<span class="mt-3 text-base font-semibold leading-snug text-[#163a2a]">{service.heading}</span>
											<span class="mt-3 text-xs font-semibold text-[#547000]">View service ↗</span>
										</a>
									))}
								</div>
							</section>
						)}

						<section class="mt-12 border-t border-[#dfe3d9] pt-10">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Continue reading</p>
							<ul class="mt-6 space-y-3">
								{otherPosts.map((entry) => (
									<li>
										<a href={`/blog/${entry.slug}`} class="flex w-full flex-col items-start rounded-2xl border border-[#dfe3d9] bg-white p-5 hover:border-[#a9ba57]">
											<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#789400]">{entry.label}</span>
											<span class="mt-2 text-sm font-semibold leading-snug text-[#163a2a]">{entry.title}</span>
										</a>
									</li>
								))}
							</ul>
						</section>

						<section class="mt-12 rounded-3xl bg-[#163a2a] p-7 text-white sm:p-9">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">Need advice on your situation?</p>
							<h2 class="mt-3 max-w-xl text-3xl font-semibold leading-tight">Professional legal consultation.</h2>
							<p class="mt-4 max-w-xl text-sm leading-6 text-[#c4d0c5]">Discuss your matter confidentially with a {site.city} legal practitioner and corporate consultant.</p>
							<div class="mt-7 flex flex-wrap gap-3">
								<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#d5e767] px-5 py-3 text-sm font-bold text-[#163a2a]">WhatsApp {site.phone} ↗</a>
								<a href={phoneHref} class="rounded-full border border-white/25 px-5 py-3 text-sm font-bold text-white">Call now</a>
							</div>
						</section>
					</div>
				</div>
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
