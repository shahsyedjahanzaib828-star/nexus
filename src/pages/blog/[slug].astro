---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, type BlogPost } from '../../data/blog';

export function getStaticPaths() {
	return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const phone = '03343108863';
const phoneHref = `tel:+92${phone.slice(1)}`;
const whatsappHref = `https://wa.me/92${phone.slice(1)}`;
const canonical = `https://nexus-alpha-ten-66.vercel.app/blog/${post.slug}`;
const articleSchema = {
	'@type': 'BlogPosting',
	'headline': post.title,
	'description': post.description,
	'url': canonical,
	'datePublished': post.date,
	'dateModified': post.date,
	'inLanguage': 'en-PK',
	'author': { '@type': 'Person', name: 'Jahanzaib' },
	'publisher': { '@type': 'Organization', name: 'Jahanzaib Legal Practice' },
	'about': ['Legal services in Karachi', 'Pakistan business law', post.label]
};
const faqSchema = {
	'@type': 'FAQPage',
	'mainEntity': post.faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
};
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema] };
---

<Layout title={post.seoTitle} description={post.description} canonical={canonical} ogImage={`/og/${post.slug}.svg`} ogImageAlt={`${post.title} by Jahanzaib Legal Practice`} schema={schema} type="article">
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<header class="border-b border-[#dfe3d9] bg-[#f6f7f2]"><div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 lg:px-10"><a href="/" aria-label="Jahanzaib Legal Services home" class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#163a2a] text-xl text-[#d5e767]">§</span><span class="text-sm font-bold leading-tight">Jahanzaib Legal Services <span class="block text-[10px] font-medium uppercase tracking-[0.15em] text-[#68736b]">Legal Practitioner & Corporate Consultant</span></span></a><nav class="hidden gap-7 text-sm font-semibold text-[#516058] lg:flex" aria-label="Main navigation"><a href="/" class="hover:text-[#163a2a]">Home</a><a href="/blog" class="text-[#789400]">Blog</a><a href="/#contact" class="hover:text-[#163a2a]">Contact</a></nav><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#163a2a] px-4 py-2.5 text-sm font-bold text-white hover:-translate-y-0.5">Consult now ↗</a></div></header>

		<main id="main-content">
			<article>
				<header class="border-b border-[#dfe3d9] bg-[#edf1e8]"><div class="mx-auto max-w-4xl px-5 py-16 lg:px-10 lg:py-24"><a href="/blog" class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">← Legal insights</a><p class="mt-10 text-xs font-bold uppercase tracking-[0.2em] text-[#487157]">{post.label} · {post.readingTime}</p><h1 class="mt-5 text-5xl font-semibold leading-[1.02] tracking-[-0.05em] text-[#163a2a] sm:text-7xl">{post.title}</h1><p class="mt-8 max-w-3xl text-xl leading-8 text-[#536158]">{post.intro}</p><div class="mt-8 flex items-center gap-4 text-sm text-[#68736b]"><span>By <strong class="text-[#163a2a]">Jahanzaib</strong></span><span aria-hidden="true">·</span><time datetime={post.date}>{post.date}</time></div></div></header>

				<div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[220px_1fr] lg:px-10 lg:py-24">
					<aside class="h-fit rounded-2xl border border-[#dfe3d9] bg-white p-5 lg:sticky lg:top-6"><p class="text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">In this article</p><nav class="mt-4" aria-label="Table of contents"><ol class="space-y-3 text-sm leading-5 text-[#68736b]">{post.sections.map((section, index) => <li><a class="hover:text-[#163a2a]" href={`#section-${index + 1}`}>{index + 1}. {section.heading}</a></li>)}<li><a class="hover:text-[#163a2a]" href="#faq">FAQs</a></li></ol></nav></aside>

					<div class="min-w-0"><div class="prose-like max-w-3xl">{post.sections.map((section, index) => <section id={`section-${index + 1}`} class="scroll-mt-8 border-b border-[#e1e5dd] pb-10 pt-2 first:pt-0 last:border-0"><h2 class="text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#163a2a]">{section.heading}</h2>{section.paragraphs.map((paragraph) => <p class="mt-5 text-base leading-8 text-[#536158]">{paragraph}</p>)}{section.points && <div class="mt-6 rounded-2xl bg-[#edf1e8] p-5"><h3 class="text-sm font-bold uppercase tracking-[0.14em] text-[#487157]">Risk points to discuss</h3><ul class="mt-4 space-y-3">{section.points.map((point) => <li class="flex gap-3 text-sm leading-6 text-[#4e5b53]"><span class="text-[#789400]">+</span><span>{point}</span></li>)}</ul></div>}</section>)}</div>

						<section id="faq" class="scroll-mt-8 border-t border-[#dfe3d9] pt-10"><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Frequently asked questions</p><h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] text-[#163a2a]">Questions Karachi clients often ask</h2><div class="mt-7 space-y-4">{post.faq.map(([question, answer]) => <details class="group rounded-2xl border border-[#dfe3d9] bg-white p-5"><summary class="cursor-pointer list-none pr-6 text-base font-semibold text-[#163a2a] marker:hidden">{question}<span class="float-right text-[#789400] group-open:rotate-45">+</span></summary><p class="mt-4 text-sm leading-7 text-[#68736b]">{answer}</p></details>)}</div></section>

						<section class="mt-12 rounded-3xl bg-[#163a2a] p-7 text-white sm:p-9"><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">Need advice on your situation?</p><h2 class="mt-3 max-w-xl text-3xl font-semibold leading-tight">Professional legal consultation.</h2><p class="mt-4 max-w-xl text-sm leading-6 text-[#c4d0c5]">Discuss your matter confidentially with a Karachi legal practitioner and corporate consultant.</p><div class="mt-7 flex flex-wrap gap-3"><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#d5e767] px-5 py-3 text-sm font-bold text-[#163a2a]">WhatsApp {phone} ↗</a><a href={phoneHref} class="rounded-full border border-white/25 px-5 py-3 text-sm font-bold text-white">Call now</a></div></section>
					</div>
				</div>
			</article>
		</main>

		<footer class="border-t border-[#dfe3d9] bg-[#edf1e8]"><div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-10 text-sm text-[#68736b] sm:flex-row sm:items-center sm:justify-between lg:px-10"><p><strong class="text-[#163a2a]">Jahanzaib Legal Services</strong> · Karachi, Sindh, Pakistan.</p><div class="flex gap-5"><a href="/blog" class="hover:text-[#163a2a]">All insights</a><a href="/#contact" class="hover:text-[#163a2a]">Contact</a><a href={phoneHref} class="hover:text-[#163a2a]">Call now</a></div></div></footer>
	</div>
</Layout>
