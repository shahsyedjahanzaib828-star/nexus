---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { blogPosts, getRelatedArticles, type BlogPost } from '../../data/blog';
import { services } from '../../data/services';
import { site, absoluteUrl, entityIds, practitioner, phoneHref, whatsappHref } from '../../data/site';
import { linkify } from '../../lib/linkify';

export function getStaticPaths() {
	return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const canonical = absoluteUrl(`/blog/${post.slug}`);

// Services that reference this article, so each post links back to the practice area it supports.
const relatedServices = services.filter((service) => (service.related as readonly string[]).includes(post.slug));
const relatedArticles = getRelatedArticles(post);

const publishedDate = post.date;
const modifiedDate = 'updated' in post && typeof (post as { updated?: string }).updated === 'string'
	? (post as { updated: string }).updated
	: post.date;

const webpageSchema = {
	'@type': 'WebPage',
	'@id': `${canonical}#webpage`,
	'url': canonical,
	'name': post.title,
	'description': post.description,
	'isPartOf': { '@id': entityIds.website },
	'about': { '@id': entityIds.organization },
	'inLanguage': 'en-PK'
};

const articleSchema = {
	'@type': 'BlogPosting',
	'@id': `${canonical}#article`,
	'headline': post.title,
	'description': post.description,
	'url': canonical,
	'datePublished': publishedDate,
	'dateModified': modifiedDate,
	'inLanguage': 'en-PK',
	'wordCount': post.sections.reduce((total, section) => total + section.paragraphs.join(' ').split(/\s+/).length, 0),
	'author': { '@id': entityIds.person },
	'publisher': { '@id': entityIds.organization },
	'mainEntityOfPage': { '@id': `${canonical}#webpage` },
	'image': absoluteUrl(`/og/${post.slug}.png`),
	'about': [
		{ '@id': entityIds.organization },
		`Legal services in ${site.city}`,
		`${site.country} business law`,
		post.label
	]
};
const faqSchema = {
	'@type': 'FAQPage',
	'mainEntity': post.faq.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
};
const schema = { '@context': 'https://schema.org', '@graph': [webpageSchema, articleSchema, faqSchema] };

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Blog', href: '/blog' },
	{ name: post.label, href: `/blog/${post.slug}` }
];
---

<Layout
	title={post.seoTitle}
	description={post.description}
	canonical={canonical}
	ogImage={`/og/${post.slug}.png`}
	ogImageAlt={`${post.title} — ${site.name}`}
	schema={schema}
	type="article"
	breadcrumbs={breadcrumbs}
	includePracticeEntity={true}
	publishedTime={`${publishedDate}T00:00:00.000Z`}
	modifiedTime={modifiedDate !== publishedDate ? `${modifiedDate}T00:00:00.000Z` : undefined}
>
	<div class="min-h-screen bg-[#fbfaf8] text-[#252424] selection:bg-[#a83009] selection:text-white">
		<SiteHeader current="blog" />

		<main id="main-content">
			<article>
				<header class="border-b border-[#e9e6e2] bg-[#f5f2ee]">
					<div class="mx-auto max-w-4xl px-5 py-16 lg:px-10 lg:py-24">
						<nav aria-label="Breadcrumb">
							<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">
								<li><a href="/" class="hover:text-[#0c0c0c]">Home</a></li>
								<li aria-hidden="true">/</li>
								<li><a href="/blog" class="hover:text-[#0c0c0c]">Blog</a></li>
								<li aria-hidden="true">/</li>
								<li class="text-[#4a4947]">{post.label}</li>
							</ol>
						</nav>
						<p class="mt-10 text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">{post.label} · {post.readingTime}</p>
						<h1 class="mt-5 text-3xl font-semibold leading-[1.08] tracking-[-0.04em] text-[#0c0c0c] sm:text-5xl lg:text-7xl">{post.title}</h1>
						<p class="mt-8 max-w-3xl text-xl leading-8 text-[#4a4947]">{post.intro}</p>
						<div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-[#696764]">
							<span>By <a href="/about" class="font-bold text-[#0c0c0c] hover:text-[#a83009]">{practitioner.name}</a>, {practitioner.jobTitle} at {site.name}</span>
							<span aria-hidden="true">·</span>
							<time datetime={publishedDate}>Published {publishedDate}</time>
							{modifiedDate !== publishedDate && (
								<>
									<span aria-hidden="true">·</span>
									<time datetime={modifiedDate}>Updated {modifiedDate}</time>
								</>
							)}
						</div>
					</div>
				</header>

				<div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[240px_1fr] lg:px-10 lg:py-24">
					<aside class="h-fit space-y-6 lg:sticky lg:top-6">
						<div class="rounded-2xl border border-[#e9e6e2] bg-white p-5">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">In this article</p>
							<nav class="mt-4" aria-label="Table of contents">
								<ol class="space-y-3 text-sm leading-5 text-[#696764]">
									{post.sections.map((section, index) => (
										<li><a class="hover:text-[#0c0c0c]" href={`#section-${index + 1}`}>{index + 1}. {section.heading}</a></li>
									))}
									<li><a class="hover:text-[#0c0c0c]" href="#faq">FAQs</a></li>
								</ol>
							</nav>
						</div>
						{relatedServices.length > 0 && (
							<div class="rounded-2xl border border-[#e9e6e2] bg-white p-5">
								<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">Related service</p>
								<ul class="mt-4 space-y-3 text-sm leading-5 text-[#696764]">
									{relatedServices.map((service) => (
										<li><a class="font-semibold text-[#a83009] hover:text-[#0c0c0c]" href={`/services/${service.slug}`}>{service.label} ↗</a></li>
									))}
								</ul>
							</div>
						)}
					</aside>

					<div class="min-w-0">
						<div class="prose-like max-w-3xl">
							{post.sections.map((section, index) => (
								<section id={`section-${index + 1}`} class="scroll-mt-8 border-b border-[#e9e6e2] pb-10 pt-2 first:pt-0 last:border-0">
									<h2 class="text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c]">{section.heading}</h2>
									{section.paragraphs.map((paragraph) => (
										<p class="mt-5 text-base leading-8 text-[#4a4947]" set:html={linkify(paragraph)} />
									))}
									{section.points && (
										<div class="mt-6 rounded-2xl bg-[#f5f2ee] p-5">
											<h3 class="text-sm font-bold uppercase tracking-[0.14em] text-[#a83009]">Risk points to discuss</h3>
											<ul class="mt-4 space-y-3">
												{section.points.map((point) => (
													<li class="flex gap-3 text-sm leading-6 text-[#696764]"><span class="text-[#a83009]">+</span><span>{point}</span></li>
												))}
											</ul>
										</div>
									)}
								</section>
							))}
						</div>

						<section id="faq" class="scroll-mt-8 border-t border-[#e9e6e2] pt-10">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Frequently asked questions</p>
							<h2 class="mt-4 text-3xl font-semibold tracking-[-0.035em] text-[#0c0c0c]">Questions {site.city} clients often ask</h2>
							<div class="mt-7 space-y-4">
								{post.faq.map(([question, answer]) => (
									<details class="group rounded-2xl border border-[#e9e6e2] bg-white p-2 sm:p-3">
										<summary class="touch-target flex min-h-12 w-full cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-3 py-3 text-left text-base font-semibold text-[#0c0c0c] marker:hidden">
											<span class="pr-2">{question}</span>
											<span class="shrink-0 text-[#a83009] group-open:rotate-45" aria-hidden="true">+</span>
										</summary>
										<p class="px-3 pb-3 text-sm leading-7 text-[#696764]">{answer}</p>
									</details>
								))}
							</div>
						</section>

						{relatedServices.length > 0 && (
							<section class="mt-12 border-t border-[#e9e6e2] pt-10">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">How this practice can help</p>
								<div class="mt-6 grid gap-4 sm:grid-cols-2">
									{relatedServices.map((service) => (
										<a href={`/services/${service.slug}`} class="flex flex-col items-start rounded-2xl border border-[#e9e6e2] bg-white p-5 hover:-translate-y-0.5 hover:border-[#faac93]">
											<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">{service.label}</span>
											<span class="mt-3 text-base font-semibold leading-snug text-[#0c0c0c]">{service.heading}</span>
											<span class="mt-3 text-xs font-semibold text-[#a83009]">View service ↗</span>
										</a>
									))}
								</div>
							</section>
						)}

						{relatedArticles.length > 0 && (
							<section class="mt-12 border-t border-[#e9e6e2] pt-10">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Related reading</p>
								<ul class="mt-6 space-y-3">
									{relatedArticles.map((entry) => (
										<li>
											<a href={`/blog/${entry.slug}`} class="flex w-full flex-col items-start rounded-2xl border border-[#e9e6e2] bg-white p-5 hover:border-[#faac93]">
												<span class="text-xs font-bold uppercase tracking-[0.14em] text-[#a83009]">{entry.label}</span>
												<span class="mt-2 text-sm font-semibold leading-snug text-[#0c0c0c]">{entry.title}</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						)}

						<section class="mt-12 rounded-3xl bg-[#0c0c0c] p-7 text-white sm:p-9">
							<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#f45a27]">Need advice on your situation?</p>
							<h2 class="mt-3 max-w-xl text-3xl font-semibold leading-tight">Professional legal consultation.</h2>
							<p class="mt-4 max-w-xl text-sm leading-6 text-[#dcdad6]">Discuss your matter confidentially with a {site.city} legal practitioner and corporate consultant.</p>
							<div class="mt-7 flex flex-wrap gap-3">
								<a href="/contact" class="rounded-full bg-[#a83009] px-5 py-3 text-sm font-bold text-white">Request a consultation ↗</a>
								<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-3 text-sm font-bold text-white">WhatsApp {site.phone}</a>
								<a href={phoneHref} class="rounded-full border border-white/25 px-5 py-3 text-sm font-bold text-white">Call now</a>
							</div>
						</section>
					</div>
				</div>
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
