---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blog';

const title = 'Legal Insights | Karachi Lawyer Blog';
const description = 'Legal insights on FBR tax compliance, SECP company registration, IPO trademark Pakistan, and business law in Karachi.';
const siteUrl = 'https://nexus-alpha-ten-66.vercel.app';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'name': title,
	'description': description,
	'url': `${siteUrl}/blog`,
	'author': { '@type': 'Person', name: 'Jahanzaib' },
	'hasPart': blogPosts.map((post) => ({ '@type': 'BlogPosting', headline: post.title, url: `${siteUrl}/blog/${post.slug}` }))
};
---

<Layout title={title} description={description} canonical={`${siteUrl}/blog`} ogImage="/og/blog.svg" ogImageAlt="Legal insights from Jahanzaib Legal Practice in Karachi" schema={schema}>
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<header class="border-b border-[#dfe3d9] bg-[#f6f7f2]"><div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 lg:px-10"><a href="/" aria-label="Jahanzaib Legal Services home" class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#163a2a] text-xl text-[#d5e767]">§</span><span class="text-sm font-bold leading-tight">Jahanzaib Legal Services <span class="block text-[10px] font-medium uppercase tracking-[0.15em] text-[#18231e]">Legal Practitioner & Corporate Consultant</span></span></a><nav class="hidden gap-7 text-sm font-semibold text-[#516058] lg:flex" aria-label="Main navigation"><a href="/" class="hover:text-[#163a2a]">Home</a><a href="/blog" class="text-[#789400]">Blog</a><a href="/#contact" class="hover:text-[#163a2a]">Contact</a></nav><a href="https://wa.me/923343108863" target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#163a2a] px-4 py-2.5 text-sm font-bold text-white hover:-translate-y-0.5">Consult now ↗</a></div></header>

		<main id="main-content">
			<section class="border-b border-[#dfe3d9] bg-[#edf1e8]"><div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24"><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#487157]">Legal knowledge for Karachi businesses</p><h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.055em] text-[#163a2a] sm:text-7xl">Practical insight for <span class="text-[#789400]">serious decisions.</span></h1><p class="mt-8 max-w-2xl text-lg leading-8 text-[#18231e]">Clear legal perspectives on litigation, FBR tax compliance, SECP company registration, IPO trademark Pakistan, and business risk across Karachi and Pakistan.</p></div></section>

			<section class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24"><div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{blogPosts.map((post, index) => <article class:list={["group flex flex-col rounded-3xl border bg-white p-6 hover:-translate-y-1 hover:shadow-lg", index === 0 ? "border-[#a9ba57] md:col-span-2 lg:col-span-2" : "border-[#dfe3d9]"]}><div class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.16em] text-[#789400]"><span>{post.label}</span><time datetime={post.date} class="font-medium tracking-normal text-[#18231e]">{post.date}</time></div><h2 class:list={["mt-8 font-semibold leading-tight tracking-[-0.035em] text-[#163a2a]", index === 0 ? "text-3xl sm:text-4xl" : "text-2xl"]}>{post.title}</h2><p class="mt-4 text-sm leading-6 text-[#18231e]">{post.description}</p><div class="mt-8 flex items-center justify-between border-t border-[#e5e8e1] pt-5 text-sm"><span class="text-[#18231e]">{post.readingTime}</span><a href={`/blog/${post.slug}`} class="font-bold text-[#547000] group-hover:text-[#163a2a]">Read article <span aria-hidden="true">↗</span></a></div></article>)}</div></section>

			<section class="border-y border-[#dfe3d9] bg-[#163a2a] text-white"><div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-14 sm:flex-row sm:items-center sm:justify-between lg:px-10"><div><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">Have a matter to discuss?</p><h2 class="mt-3 text-3xl font-semibold tracking-tight">A clear next step starts with a conversation.</h2></div><a href="https://wa.me/923343108863" target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#d5e767] px-6 py-3.5 text-center text-sm font-bold text-[#163a2a]">Consult now ↗</a></div></section>
		</main>

		<footer class="border-t border-[#dfe3d9] bg-[#edf1e8]"><div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-10 text-sm text-[#18231e] sm:flex-row sm:items-center sm:justify-between lg:px-10"><p><strong class="text-[#163a2a]">Jahanzaib Legal Services</strong> · Legal Practitioner & Corporate Consultant in Karachi, Pakistan.</p><div class="flex gap-5"><a href="/" class="hover:text-[#163a2a]">Home</a><a href="/#contact" class="hover:text-[#163a2a]">Contact</a><a href="tel:+923343108863" class="hover:text-[#163a2a]">Call now</a></div></div></footer>
	</div>
</Layout>
