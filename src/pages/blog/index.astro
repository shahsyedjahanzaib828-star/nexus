---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { blogPosts } from '../../data/blog';
import { site, whatsappHref } from '../../data/site';

const title = 'Legal Blog | Karachi Lawyer on Tax, Company & Property Law';
const description =
	'Legal insights on FBR tax compliance, SECP company registration, IPO trademark Pakistan, property due diligence, bail and family law in Karachi.';
const canonical = `${site.url}/blog`;

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Blog',
			'@id': `${canonical}#blog`,
			'name': title,
			'description': description,
			'url': canonical,
			'inLanguage': 'en-PK',
			'publisher': { '@id': `${site.url}/#legal-service` }
		},
		{
			'@type': 'ItemList',
			'itemListElement': blogPosts.map((post, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: post.title,
				url: `${site.url}/blog/${post.slug}`
			}))
		}
	]
};

const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Blog', href: '/blog' }
];
---

<Layout
	title={title}
	description={description}
	canonical={canonical}
	ogImage="/og/blog.png"
	ogImageAlt={`Legal insights from ${site.name} in ${site.city}`}
	schema={schema}
	breadcrumbs={breadcrumbs}
>
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<SiteHeader current="blog" />

		<main id="main-content">
			<section class="border-b border-[#dfe3d9] bg-[#edf1e8]">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24">
					<nav aria-label="Breadcrumb">
						<ol class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-[#487157]">
							<li><a href="/" class="hover:text-[#163a2a]">Home</a></li>
							<li aria-hidden="true">/</li>
							<li class="text-[#68736b]">Blog</li>
						</ol>
					</nav>
					<p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-[#487157]">Legal knowledge for {site.city} businesses</p>
					<h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.055em] text-[#163a2a] sm:text-7xl">
						Practical insight for <span class="text-[#789400]">serious decisions.</span>
					</h1>
					<p class="mt-8 max-w-2xl text-lg leading-8 text-[#18231e]">
						Clear legal perspectives on litigation, FBR tax compliance, SECP company registration, IPO trademark Pakistan, and business risk across {site.city} and {site.country}.
					</p>
				</div>
			</section>

			<section class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-24">
				<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{blogPosts.map((post, index) => (
						<article class:list={["group flex flex-col rounded-3xl border bg-white p-6 hover:-translate-y-1 hover:shadow-lg", index === 0 ? "border-[#a9ba57] md:col-span-2 lg:col-span-2" : "border-[#dfe3d9]"]}>
							<div class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.16em] text-[#789400]">
								<span>{post.label}</span>
								<time datetime={post.date} class="font-medium tracking-normal text-[#18231e]">{post.date}</time>
							</div>
							<h2 class:list={["mt-8 font-semibold leading-tight tracking-[-0.035em] text-[#163a2a]", index === 0 ? "text-3xl sm:text-4xl" : "text-2xl"]}>
								<a href={`/blog/${post.slug}`} class="hover:text-[#547000]">{post.title}</a>
							</h2>
							<p class="mt-4 text-sm leading-6 text-[#18231e]">{post.description}</p>
							<div class="mt-8 flex items-center justify-between border-t border-[#e5e8e1] pt-5 text-sm">
								<span class="text-[#18231e]">{post.readingTime}</span>
								<a href={`/blog/${post.slug}`} class="font-bold text-[#547000] group-hover:text-[#163a2a]">Read article <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="border-y border-[#dfe3d9] bg-[#163a2a] text-white">
				<div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-14 sm:flex-row sm:items-center sm:justify-between lg:px-10">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">Have a matter to discuss?</p>
						<h2 class="mt-3 text-3xl font-semibold tracking-tight">A clear next step starts with a conversation.</h2>
					</div>
					<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#d5e767] px-6 py-3.5 text-center text-sm font-bold text-[#163a2a]">Consult now ↗</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
