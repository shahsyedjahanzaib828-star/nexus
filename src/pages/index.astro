---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { services } from '../data/services';
import { blogPosts } from '../data/blog';
import { site, absoluteUrl, phoneHref, whatsappHref, mailHref } from '../data/site';

const latestPosts = blogPosts.slice(0, 6);

const homeFaq: [string, string][] = [
	[
		'What areas of law does the practice cover in Karachi?',
		'Civil, criminal and family litigation, property and construction matters including SBCA approvals, SECP company registration and corporate compliance, FBR and SRB tax filing, WeBOC import and export registration, and trademark protection through IPO Pakistan.'
	],
	[
		'How do I start a consultation?',
		'Call or send a WhatsApp message on ' + site.phone + ', or submit the enquiry form on this page with a brief summary of the matter. An initial enquiry does not create an advocate-client relationship.'
	],
	[
		'Does the practice handle matters outside Karachi?',
		'The practice is based in ' + site.city + ' and appears before the courts and authorities of ' + site.region + '. Corporate, tax, trademark and advisory work is handled for clients across ' + site.country + ', including those operating through foreign entities.'
	],
	[
		'What should I bring to a first consultation?',
		'Any documents connected to the matter: agreements, notices, FIR or court papers, title or revenue records, tax notices, company filings, and correspondence with the other side. The available record usually determines the realistic options.'
	],
	[
		'Can the outcome of a case be guaranteed?',
		'No. Outcomes depend on the facts, the evidence and the court or authority deciding the matter. The practice provides representation and legal analysis, not assurances of a particular result.'
	],
	[
		'Are fees published on this website?',
		'No. The work required depends on the documents, the forum and the stage of the matter. Fees are discussed after the initial facts are understood and before any engagement is confirmed in writing.'
	],
	[
		'Is website information legal advice?',
		'No. Pages and articles are general information only. Advice is given after the specific facts and documents have been reviewed, and only once an engagement has been agreed.'
	]
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'FAQPage',
			'mainEntity': homeFaq.map(([question, answer]) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer }
			}))
		}
	]
};
---

<Layout
	schema={schema}
	canonical={absoluteUrl('/')}
	includePracticeEntity={true}
	ogImage="/og/home.png"
	ogImageAlt={`${site.name} — lawyer in ${site.city}`}
>
	<div class="min-h-screen bg-[#fbfaf8] text-[#252424] selection:bg-[#a83009] selection:text-white">
		<SiteHeader current="home" />

		<main id="main-content">
			<section class="border-b border-[#e9e6e2] bg-[#f5f2ee]">
				<div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-10 lg:py-24">
					<div>
						<p class="mb-6 text-xs font-bold uppercase tracking-[0.2em] text-slate-900">{site.city} · {site.region} · {site.country}</p>
						<h1 class="text-[2.4rem] font-semibold leading-[0.98] tracking-[-0.055em] text-[#0c0c0c] sm:text-6xl lg:text-[6.5rem]">
							Legal counsel in {site.city} for <span class="text-[#a83009]">real stakes.</span>
						</h1>
						<p class="mt-8 max-w-2xl text-lg leading-8 text-slate-900">
							{site.name} provides comprehensive legal, corporate, tax, and litigation counsel for individuals, families, founders, and businesses across {site.city} and {site.country}.
						</p>
						<div class="mt-9 flex flex-wrap gap-4">
							<a href="#contact" class="rounded-full bg-[#a83009] px-6 py-3.5 text-sm font-bold text-white">
								Discuss your matter ↗
							</a>
							<a href={phoneHref} class="rounded-full border border-[#c4c2be] px-5 py-3.5 text-sm font-bold text-[#0c0c0c]">
								Call Now: {site.phone}
							</a>
							<a href="#how-it-works" class="rounded-full px-5 py-3.5 text-sm font-bold text-[#a83009]">
								See how it works
							</a>
						</div>
						<div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-xs font-semibold text-slate-900">
							<span class="text-slate-900">✓ {site.city}-based counsel</span>
							<span class="text-slate-900">✓ Confidential consultation</span>
							<span class="text-slate-900">✓ {site.country}-wide support</span>
						</div>
					</div>
					<div class="rounded-[2rem] bg-[#0c0c0c] p-7 text-white shadow-xl shadow-[#0c0c0c]/15 sm:p-9">
						<p class="text-xs font-bold uppercase tracking-[0.18em] text-[#f45a27]">Practice at a glance</p>
						<h2 class="mt-3 text-3xl font-semibold leading-tight">One trusted point of contact.</h2>
						<div class="grid grid-cols-2 gap-8 pt-8">
							<div>
								<p class="text-3xl font-semibold text-[#f45a27]">{services.length}</p>
								<p class="text-xs text-[#c4c2be]">core practice areas</p>
							</div>
							<div>
								<p class="text-3xl font-semibold text-[#f45a27]">360°</p>
								<p class="text-xs text-[#c4c2be]">legal &amp; corporate support</p>
							</div>
							<div>
								<p class="text-3xl font-semibold text-[#f45a27]">PK</p>
								<p class="text-xs text-[#c4c2be]">{site.city}-based, nationwide</p>
							</div>
							<div>
								<p class="text-3xl font-semibold text-[#f45a27]">1:1</p>
								<p class="text-xs text-[#c4c2be]">direct consultation</p>
							</div>
						</div>
						<p class="mt-8 rounded-2xl bg-white/10 p-4 text-sm leading-6 text-[#e9e6e2]">
							Civil, criminal, and family litigation, SECP setup, WeBOC registration, FBR returns, foreign LLC tax, SBCA compliance, and IPO trademark protection.
						</p>
					</div>
				</div>
			</section>

			<section class="border-b border-[#e9e6e2] bg-white">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-20">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Find the support that fits</p>
					<h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c] sm:text-4xl">Choose how you want to start.</h2>
					<div class="mt-10 grid gap-4 md:grid-cols-3">
						<article class="flex flex-col rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">01 · Consultation</p>
							<h3 class="mt-4 text-xl font-semibold text-[#0c0c0c]">Discuss a matter</h3>
							<p class="mt-3 flex-1 text-sm leading-6 text-[#696764]">Share the facts, documents and deadline. An initial enquiry does not create an advocate-client relationship.</p>
							<a href="#contact" class="mt-6 text-sm font-bold text-[#a83009]">Go to the enquiry form ↗</a>
						</article>
						<article class="flex flex-col rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">02 · Practice areas</p>
							<h3 class="mt-4 text-xl font-semibold text-[#0c0c0c]">Read the service pages</h3>
							<p class="mt-3 flex-1 text-sm leading-6 text-[#696764]">Litigation, property, company setup, tax, WeBOC and trademarks each have a dedicated page of what the work involves.</p>
							<a href="/services" class="mt-6 text-sm font-bold text-[#a83009]">Browse practice areas ↗</a>
						</article>
						<article class="flex flex-col rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
							<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">03 · Legal insights</p>
							<h3 class="mt-4 text-xl font-semibold text-[#0c0c0c]">Review a written guide</h3>
							<p class="mt-3 flex-1 text-sm leading-6 text-[#696764]">Articles on bail, khula, FBR filing, SECP structure and property due diligence, written for {site.city} clients.</p>
							<a href="/blog" class="mt-6 text-sm font-bold text-[#a83009]">Open the blog ↗</a>
						</article>
					</div>
				</div>
			</section>

			<section id="practice-areas" class="mx-auto max-w-7xl px-5 py-20 lg:px-10 lg:py-28">
				<div class="max-w-2xl">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Comprehensive legal portfolio</p>
					<h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-[#0c0c0c] sm:text-5xl">Legal support that meets the whole picture.</h2>
					<p class="mt-5 text-base leading-7 text-[#252424]">Practical counsel grounded in the realities of {site.city}, {site.region}, and {site.country}.</p>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{services.map((service, index) => (
						<article class="group flex flex-col rounded-3xl border border-[#e9e6e2] bg-white p-6 hover:-translate-y-1 hover:border-[#faac93] hover:shadow-lg">
							<div class="flex items-start justify-between">
								<span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#fef5f2] text-xl font-semibold text-[#a83009]" aria-hidden="true">{service.icon}</span>
								<span class="text-xs font-bold text-[#252424]">0{index + 1}</span>
							</div>
							<h3 class="mt-8 text-xl font-semibold leading-tight text-[#0c0c0c]">
								<a href={`/services/${service.slug}`} class="hover:text-[#a83009]">{service.heading}</a>
							</h3>
							<ul class="mt-6 space-y-3 border-t border-[#e9e6e2] pt-5">
								{service.offerings.slice(0, 4).map((offering) => (
									<li class="flex gap-2 text-sm leading-5 text-[#696764]"><span class="text-[#a83009]">+</span><span>{offering}</span></li>
								))}
							</ul>
							<a href={`/services/${service.slug}`} class="mt-6 text-sm font-bold text-[#a83009] group-hover:text-[#0c0c0c]">
								Learn more <span aria-hidden="true">↗</span>
							</a>
						</article>
					))}
				</div>
				<a href="/services" class="mt-10 inline-flex rounded-full border border-[#c4c2be] px-6 py-3.5 text-sm font-bold text-[#0c0c0c] hover:bg-white">
					View all practice areas ↗
				</a>
			</section>

			<section class="border-y border-[#e9e6e2] bg-white">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-20">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Before a filing is prepared</p>
					<h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c] sm:text-4xl">Three reasons the record comes first.</h2>
					<div class="mt-10 grid gap-4 md:grid-cols-3">
						<article class="rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
							<h3 class="text-lg font-semibold text-[#0c0c0c]">Limitation can close the door</h3>
							<p class="mt-3 text-sm leading-6 text-[#696764]">Many civil and tax matters have fixed periods. Establishing the date and the documents early is more useful than arguing a late claim.</p>
						</article>
						<article class="rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
							<h3 class="text-lg font-semibold text-[#0c0c0c]">The forum has to be the right one</h3>
							<p class="mt-3 text-sm leading-6 text-[#696764]">Family Court, civil suit, High Court writ, SECP portal and FBR notice each have their own process. Filing in the wrong place wastes time and can prejudice the position.</p>
						</article>
						<article class="rounded-3xl border border-[#e9e6e2] bg-[#fbfaf8] p-6">
							<h3 class="text-lg font-semibold text-[#0c0c0c]">A weak paper trail is hard to repair</h3>
							<p class="mt-3 text-sm leading-6 text-[#696764]">Title, tax, company and correspondence records decide what can later be proved. The first consultation is used to map what exists and what is missing.</p>
						</article>
					</div>
				</div>
			</section>

			<section id="how-it-works" class="border-y border-[#e9e6e2] bg-[#0c0c0c] text-white">
				<div class="mx-auto max-w-7xl px-5 py-20 lg:px-10 lg:py-28">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#f45a27]">A steady legal partner</p>
					<h2 class="mt-5 max-w-xl text-4xl font-semibold leading-tight tracking-[-0.04em] sm:text-5xl">Clarity before complexity.</h2>
					<div class="mt-12 grid gap-8 md:grid-cols-3">
						<div>
							<span class="text-sm font-bold text-[#f45a27]">01</span>
							<h3 class="mt-5 text-lg font-semibold">Share the situation</h3>
							<p class="mt-3 text-sm leading-6 text-[#aba9a7]">Tell us what happened, what matters, and what outcome you need.</p>
						</div>
						<div>
							<span class="text-sm font-bold text-[#f45a27]">02</span>
							<h3 class="mt-5 text-lg font-semibold">Get a clear route</h3>
							<p class="mt-3 text-sm leading-6 text-[#aba9a7]">We identify the practical legal path, timelines, and next documents.</p>
						</div>
						<div>
							<span class="text-sm font-bold text-[#f45a27]">03</span>
							<h3 class="mt-5 text-lg font-semibold">Move with counsel</h3>
							<p class="mt-3 text-sm leading-6 text-[#aba9a7]">Get focused representation and support from first step to resolution.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="border-b border-[#e9e6e2] bg-[#f5f2ee]">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-20">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">How a consultation is handled</p>
					<h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c] sm:text-4xl">Direct access, a written assessment, and fees before engagement.</h2>
					<div class="mt-10 grid gap-4 md:grid-cols-3">
						<article class="rounded-3xl bg-white p-6">
							<h3 class="text-lg font-semibold text-[#0c0c0c]">Easy to reach</h3>
							<p class="mt-3 text-sm leading-6 text-[#696764]">Call, WhatsApp or the enquiry form. You deal with the practitioner handling the matter, not a call centre queue.</p>
						</article>
						<article class="rounded-3xl bg-white p-6">
							<h3 class="text-lg font-semibold text-[#0c0c0c]">A clear reading of the file</h3>
							<p class="mt-3 text-sm leading-6 text-[#696764]">The first discussion covers the facts, the documents, the forum and whether proceedings are advisable at all.</p>
						</article>
						<article class="rounded-3xl bg-white p-6">
							<h3 class="text-lg font-semibold text-[#0c0c0c]">Scope agreed in writing</h3>
							<p class="mt-3 text-sm leading-6 text-[#696764]">Fees and the work to be done are discussed before an advocate-client relationship is created. Results are not promised.</p>
						</article>
					</div>
					<div class="mt-8 rounded-3xl border border-[#e9e6e2] bg-white p-6 sm:p-8">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">How this practice treats enquiries</p>
						<p class="mt-3 max-w-3xl text-sm leading-7 text-[#696764]">Information sent through this website is treated as confidential. It is used to respond to the enquiry. It does not become privileged legal advice, and it does not create an advocate-client relationship, until engagement is confirmed in writing. If a filing is prepared through this practice and is rejected because of an error in that filing, the correction is taken up with the relevant authority as part of the agreed work.</p>
					</div>
				</div>
			</section>

			<section class="border-b border-[#e9e6e2] bg-white">
				<div class="mx-auto max-w-7xl px-5 py-16 lg:px-10 lg:py-20">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Service area</p>
					<h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-[#0c0c0c] sm:text-4xl">Based in {site.city}, advising across {site.country}.</h2>
					<p class="mt-5 max-w-3xl text-sm leading-7 text-[#696764]">
						Court appearances are in {site.city} and {site.region}. Corporate, tax, trademark and advisory work is handled for clients elsewhere in {site.country} where the matter and forum allow. This website does not list branch offices in other cities.
					</p>
				</div>
			</section>

			<section class="mx-auto max-w-7xl px-5 py-20 lg:px-10 lg:py-24">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<div class="max-w-2xl">
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Legal insights</p>
						<h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-[#0c0c0c] sm:text-5xl">Guidance on the questions clients ask most.</h2>
					</div>
					<a href="/blog" class="rounded-full border border-[#c4c2be] px-5 py-3.5 text-sm font-bold text-[#0c0c0c] hover:bg-white">All articles ↗</a>
				</div>
				<div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{latestPosts.map((post) => (
						<article class="group flex flex-col rounded-3xl border border-[#e9e6e2] bg-white p-6 hover:-translate-y-1 hover:shadow-lg">
							<div class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">
								<span>{post.label}</span>
								<time datetime={post.date} class="font-medium tracking-normal text-[#252424]">{post.date}</time>
							</div>
							<h3 class="mt-6 text-xl font-semibold leading-tight tracking-[-0.03em] text-[#0c0c0c]">
								<a href={`/blog/${post.slug}`} class="hover:text-[#a83009]">{post.title}</a>
							</h3>
							<p class="mt-4 text-sm leading-6 text-[#696764]">{post.description}</p>
							<div class="mt-6 flex items-center justify-between border-t border-[#e9e6e2] pt-5 text-sm">
								<span class="text-[#252424]">{post.readingTime}</span>
								<a href={`/blog/${post.slug}`} class="font-bold text-[#a83009] group-hover:text-[#0c0c0c]">Read article <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					))}
				</div>
			</section>

			<section id="faq" class="border-y border-[#e9e6e2] bg-white">
				<div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:px-10 lg:py-24">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Frequently asked questions</p>
						<h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-[#0c0c0c] sm:text-5xl">Before you get in touch.</h2>
						<p class="mt-5 max-w-sm text-base leading-7 text-[#696764]">
							If your question is not covered here, ask it directly on a call or by WhatsApp.
						</p>
						<a href="/about" class="mt-7 inline-flex text-sm font-bold text-[#a83009]">About the practice ↗</a>
					</div>
					<div class="space-y-4">
						{homeFaq.map(([question, answer]) => (
							<details class="group rounded-2xl border border-[#e9e6e2] bg-[#fbfaf8] p-5">
								<summary class="cursor-pointer list-none pr-6 text-base font-semibold text-[#0c0c0c] marker:hidden">
									{question}<span class="float-right text-[#a83009] group-open:rotate-45">+</span>
								</summary>
								<p class="mt-4 text-sm leading-7 text-[#696764]">{answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>

			<section id="contact" class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-[0.75fr_1.25fr] lg:px-10 lg:py-28">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a83009]">Start with a conversation</p>
					<h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-[#0c0c0c] sm:text-5xl">Tell us where you need counsel.</h2>
					<p class="mt-5 max-w-sm text-base leading-7 text-[#252424]">Share a few details for an initial enquiry. Your information is treated with professional confidentiality.</p>
					<div class="mt-9 space-y-5 text-sm text-[#696764]">
						<a href={phoneHref} class="flex items-center gap-3 hover:text-[#0c0c0c]">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">☎</span>
							{site.phone}
						</a>
						<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-[#0c0c0c]">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">◉</span>
							WhatsApp consultation
						</a>
						<a href={mailHref} class="flex items-center gap-3 hover:text-[#0c0c0c]">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">@</span>
							{site.email}
						</a>
						<span class="flex items-center gap-3">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#fef5f2] text-[#a83009]" aria-hidden="true">⌂</span>
							{site.city}, {site.region}, {site.country}
						</span>
					</div>
				</div>
				<form id="contact-form" class="rounded-3xl border border-[#e9e6e2] bg-white p-6 shadow-sm sm:p-8">
					<div class="grid gap-5 sm:grid-cols-2">
						<label class="text-sm font-semibold text-[#4a4947]">
							Full Name
							<input required name="full-name" type="text" class="mt-2 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal outline-none focus:border-[#a83009]" />
						</label>
						<label class="text-sm font-semibold text-[#4a4947]">
							Phone Number (WhatsApp)
							<input required name="phone" type="tel" placeholder={site.phone} class="mt-2 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal outline-none focus:border-[#a83009]" />
						</label>
						<label class="text-sm font-semibold text-[#4a4947]">
							Email
							<input required name="email" type="email" class="mt-2 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal outline-none focus:border-[#a83009]" />
						</label>
						<label class="text-sm font-semibold text-[#4a4947]">
							City
							<select required name="city" class="mt-2 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal outline-none focus:border-[#a83009]">
								<option value="">Select city</option>
								<option>Karachi</option>
								<option>Other</option>
							</select>
						</label>
						<label class="text-sm font-semibold text-[#4a4947] sm:col-span-2">
							Service Required
							<select required name="service" class="mt-2 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal outline-none focus:border-[#a83009]">
								<option value="">Choose a service</option>
								{services.map((service) => <option>{service.label}</option>)}
							</select>
						</label>
						<label class="text-sm font-semibold text-[#4a4947] sm:col-span-2">
							Brief Case Details
							<textarea required name="case-details" rows="4" class="mt-2 w-full resize-y rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal outline-none focus:border-[#a83009]"></textarea>
						</label>
					</div>
					<button type="submit" class="mt-6 w-full rounded-full bg-[#0c0c0c] px-6 py-3.5 text-sm font-bold text-white">
						Request a consultation ↗
					</button>
					<p class="mt-4 text-center text-xs leading-5 text-[#252424]">
						This initial enquiry does not create an advocate-client relationship.
					</p>
				</form>
			</section>

			<section class="border-t border-[#e9e6e2] bg-[#fbfaf8] px-5 py-10 lg:px-10">
				<div class="mx-auto max-w-7xl">
					<p class="text-sm leading-6 text-[#252424]">
						{site.name} is a {site.city}-based legal practice serving clients in {site.city} and across {site.country}. Website information is general information only, not legal advice, and does not create an advocate-client relationship. Results are not guaranteed.
					</p>
					<a href="/privacy" class="mt-3 inline-flex text-sm font-bold text-[#a83009]">Read our Privacy Policy</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>

	<script define:vars={{ email: site.email }}>
		const form = document.getElementById('contact-form');
		if (form) {
			form.addEventListener('submit', (event) => {
				event.preventDefault();

				const formData = new FormData(form);
				const fullName = formData.get('full-name');
				const phone = formData.get('phone');
				const emailVal = formData.get('email');
				const city = formData.get('city');
				const service = formData.get('service');
				const caseDetails = formData.get('case-details');

				const subject = `Consultation Inquiry: ${service} - ${fullName}`;
				const body =
					`New Consultation Inquiry:\n\n` +
					`- Full Name: ${fullName}\n` +
					`- Phone Number (WhatsApp): ${phone}\n` +
					`- Email: ${emailVal}\n` +
					`- City: ${city}\n` +
					`- Service Required: ${service}\n\n` +
					`Brief Case Details:\n` +
					`${caseDetails}`;

				const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
				window.location.href = mailtoUrl;
			});
		}
	</script>
</Layout>
