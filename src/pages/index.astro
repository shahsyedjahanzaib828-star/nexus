---
import Layout from '../layouts/Layout.astro';
const phone = '03343108863';
const phoneHref = `tel:+92${phone.slice(1)}`;
const whatsappHref = `https://wa.me/92${phone.slice(1)}`;
const email = 'shahsyedjahanzaib828@gmail.com';

const practiceAreas = [
	['§', 'Civil, Criminal & Family Litigation', ['Civil Litigation & Commercial Dispute Resolution', 'Criminal Defense, Bail Matters, & Criminal Law Consultancy', 'Family Law: Khula, Divorce, Custody, Maintenance & Guardianship', 'Inheritance, Succession Certificates, & Property Partition Suits', 'High Court Constitutional Writs & Legal Notices']],
	['⌂', 'Real Estate, Land & Construction Law', ['Property Title Verification & Ownership Search', 'Sale, Lease & Gift Deeds and Real Estate Conveyancing', 'SBCA Approvals & Building Plan Compliance', 'Land Revenue, KDA, MDA & Local Authority Representation']],
	['↗', 'WeBOC Import, Export & Trade Licensing', ['WeBOC ID Registration through PSW', 'Import & Export License Setup and KCCI Membership', 'Customs Duty Advisory & International Trade Legal Support']],
	['▣', 'SECP Company Setup & Business Registration', ['Private Limited Company (Pvt Ltd) Formation', 'Single Member Company (SMC-Pvt Ltd) Setup', 'Sole Proprietorship Registration & NTN Issuance', 'Partnership Firm (AOP) & LLP Registration']],
	['%', 'FBR, SRB & International Tax Filing', ['Individual & Business FBR Income Tax Return Filing', 'STRN Sales Tax Registration & SRB Service Tax Compliance', 'US/UK LLC Tax Filing & Compliance for Freelancers and Businesses', 'Tax Audit Handling & Exemption Certificates']],
	['™', 'IPO Pakistan Trademark & IP Protection', ['Trademark Registration & Official TM Search (TM-55)', 'Brand Name, Logo, Copyright & Patent Protection', 'Trademark Opposition, Show Cause Responses & IPO Hearings']]
];
---

<Layout>
	<div class="min-h-screen bg-[#f6f7f2] text-[#18231e] selection:bg-[#d5e767] selection:text-[#18231e]">
		<header class="border-b border-[#dfe3d9] bg-[#f6f7f2]"><div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 lg:px-10"><a href="/" aria-label="Advocate Jahanzaib home" class="flex items-center gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#163a2a] text-xl text-[#d5e767]">§</span><span class="text-sm font-bold leading-tight">Advocate Jahanzaib <span class="block text-[10px] font-medium uppercase tracking-[0.15em] text-[#68736b]">Legal Practitioner & Corporate Consultant</span></span></a><nav class="hidden gap-7 text-sm font-semibold text-[#516058] lg:flex" aria-label="Main navigation"><a href="#practice-areas" class="hover:text-[#163a2a]">Practice Areas</a><a href="/blog" class="hover:text-[#163a2a]">Blog</a><a href="#contact" class="hover:text-[#163a2a]">Contact</a></nav><details class="relative lg:hidden"><summary class="list-none rounded-full border border-[#b8c3b6] px-4 py-2.5 text-sm font-bold text-[#163a2a]"><span aria-hidden="true">☰</span><span class="sr-only">Open navigation menu</span></summary><nav class="absolute right-0 top-full z-20 mt-2 grid min-w-48 gap-1 rounded-2xl border border-[#dfe3d9] bg-white p-2 text-sm font-semibold text-[#516058] shadow-xl" aria-label="Mobile navigation"><a href="#practice-areas" class="rounded-xl px-4 py-3 hover:bg-[#edf1e8] hover:text-[#163a2a]">Practice Areas</a><a href="/blog" class="mt-1 border-y border-[#dfe3d9] px-4 py-4 text-base font-bold text-[#163a2a] hover:bg-[#edf1e8]">Blog</a><a href="#contact" class="rounded-xl px-4 py-3 hover:bg-[#edf1e8] hover:text-[#163a2a]">Contact</a></nav></details><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="whitespace-nowrap rounded-full bg-[#163a2a] px-4 py-2.5 text-sm font-bold text-white hover:-translate-y-0.5">WhatsApp <span aria-hidden="true">↗</span></a></div></header>

		<main id="main-content">
			<section class="border-b border-[#dfe3d9] bg-[#edf1e8]"><div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-10 lg:py-24"><div><p class="mb-6 text-xs font-bold uppercase tracking-[0.2em] text-[#487157]">Karachi · Sindh · Pakistan</p><h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.055em] text-[#163a2a] sm:text-7xl lg:text-[6.5rem]">Strong counsel for <span class="text-[#789400]">real stakes.</span></h1><p class="mt-8 max-w-2xl text-lg leading-8 text-[#536158]">Advocate Jahanzaib provides comprehensive legal, corporate, tax, and litigation counsel for individuals, families, founders, and businesses across Karachi and Pakistan.</p><div class="mt-9 flex flex-wrap gap-4"><a href="#contact" class="rounded-full bg-[#d5e767] px-6 py-3.5 text-sm font-bold text-[#163a2a]">Discuss your matter ↗</a><a href={phoneHref} class="rounded-full border border-[#b8c3b6] px-5 py-3.5 text-sm font-bold text-[#163a2a]">Call Now: {phone}</a></div><div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-xs font-semibold text-[#68736b]"><span>✓ Karachi-based counsel</span><span>✓ Confidential consultation</span><span>✓ Pakistan-wide support</span></div></div><div class="rounded-[2rem] bg-[#163a2a] p-7 text-white shadow-xl shadow-[#163a2a]/15 sm:p-9"><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#d5e767]">Practice at a glance</p><h2 class="mt-3 text-3xl font-semibold leading-tight">One trusted point of contact.</h2><div class="grid grid-cols-2 gap-8 pt-8"><div><p class="text-3xl font-semibold text-[#d5e767]">6</p><p class="text-xs text-[#bec9bf]">core practice areas</p></div><div><p class="text-3xl font-semibold text-[#d5e767]">360°</p><p class="text-xs text-[#bec9bf]">legal & corporate support</p></div><div><p class="text-3xl font-semibold text-[#d5e767]">PK</p><p class="text-xs text-[#bec9bf]">Karachi-based, nationwide</p></div><div><p class="text-3xl font-semibold text-[#d5e767]">1:1</p><p class="text-xs text-[#bec9bf]">direct consultation</p></div></div><p class="mt-8 rounded-2xl bg-white/10 p-4 text-sm leading-6 text-[#dce4d8]">Civil, criminal, and family litigation, SECP setup, WeBOC registration, FBR returns, foreign LLC tax, SBCA compliance, and IPO trademark protection.</p></div></div></section>

			<section id="practice-areas" class="mx-auto max-w-7xl px-5 py-20 lg:px-10 lg:py-28"><div class="max-w-2xl"><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Comprehensive legal portfolio</p><h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-[#163a2a] sm:text-5xl">Legal support that meets the whole picture.</h2><p class="mt-5 text-base leading-7 text-[#68736b]">Practical counsel grounded in the realities of Karachi, Sindh, and Pakistan.</p></div><div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{practiceAreas.map((area, index) => <article class="flex flex-col rounded-3xl border border-[#dfe3d9] bg-white p-6 hover:-translate-y-1 hover:border-[#a9ba57] hover:shadow-lg"><div class="flex items-start justify-between"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#e6f0d4] text-xl font-semibold text-[#547000]">{area[0]}</span><span class="text-xs font-bold text-[#a1aaa1]">0{index + 1}</span></div><h3 class="mt-8 text-xl font-semibold leading-tight text-[#163a2a]">{area[1]}</h3><ul class="mt-6 space-y-3 border-t border-[#e5e8e1] pt-5">{(area[2] as any).map((service: any) => <li class="flex gap-2 text-sm leading-5 text-[#4e5b53]"><span class="text-[#789400]">+</span><span>{service}</span></li>)}</ul></article>)}</div></section>

			<section class="border-y border-[#dfe3d9] bg-[#163a2a] text-white"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-10 lg:py-28"><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#d5e767]">A steady legal partner</p><h2 class="mt-5 max-w-xl text-4xl font-semibold leading-tight tracking-[-0.04em] sm:text-5xl">Clarity before complexity.</h2><div class="mt-12 grid gap-8 md:grid-cols-3"><div><span class="text-sm font-bold text-[#d5e767]">01</span><h3 class="mt-5 text-lg font-semibold">Share the situation</h3><p class="mt-3 text-sm leading-6 text-[#b9c7bb]">Tell us what happened, what matters, and what outcome you need.</p></div><div><span class="text-sm font-bold text-[#d5e767]">02</span><h3 class="mt-5 text-lg font-semibold">Get a clear route</h3><p class="mt-3 text-sm leading-6 text-[#b9c7bb]">We identify the practical legal path, timelines, and next documents.</p></div><div><span class="text-sm font-bold text-[#d5e767]">03</span><h3 class="mt-5 text-lg font-semibold">Move with counsel</h3><p class="mt-3 text-sm leading-6 text-[#b9c7bb]">Get focused representation and support from first step to resolution.</p></div></div></div></section>

			<section id="contact" class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-[0.75fr_1.25fr] lg:px-10 lg:py-28">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-[#789400]">Start with a conversation</p>
					<h2 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-[#163a2a] sm:text-5xl">Tell us where you need counsel.</h2>
					<p class="mt-5 max-w-sm text-base leading-7 text-[#68736b]">Share a few details for an initial enquiry. Your information is treated with professional confidentiality.</p>
					<div class="mt-9 space-y-5 text-sm text-[#4e5b53]">
						<a href={phoneHref} class="flex items-center gap-3 hover:text-[#163a2a]">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#e6f0d4] text-[#547000]">☎</span>
							{phone}
						</a>
						<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:text-[#163a2a]">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#e6f0d4] text-[#547000]">◉</span>
							WhatsApp consultation
						</a>
						<a href={`mailto:${email}`} class="flex items-center gap-3 hover:text-[#163a2a]">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#e6f0d4] text-[#547000]">@</span>
							{email}
						</a>
						<span class="flex items-center gap-3">
							<span class="grid h-9 w-9 place-items-center rounded-full bg-[#e6f0d4] text-[#547000]">⌂</span>
							Karachi, Sindh, Pakistan
						</span>
					</div>
				</div>
				<form id="contact-form" class="rounded-3xl border border-[#dfe3d9] bg-white p-6 shadow-sm sm:p-8">
					<div class="grid gap-5 sm:grid-cols-2">
						<label class="text-sm font-semibold text-[#35453b]">
							Full Name
							<input required name="full-name" type="text" class="mt-2 w-full rounded-xl border border-[#d5dbd2] bg-[#fbfcf9] px-4 py-3 text-sm font-normal outline-none focus:border-[#789400]" />
						</label>
						<label class="text-sm font-semibold text-[#35453b]">
							Phone Number (WhatsApp)
							<input required name="phone" type="tel" placeholder={phone} class="mt-2 w-full rounded-xl border border-[#d5dbd2] bg-[#fbfcf9] px-4 py-3 text-sm font-normal outline-none focus:border-[#789400]" />
						</label>
						<label class="text-sm font-semibold text-[#35453b]">
							Email
							<input required name="email" type="email" class="mt-2 w-full rounded-xl border border-[#d5dbd2] bg-[#fbfcf9] px-4 py-3 text-sm font-normal outline-none focus:border-[#789400]" />
						</label>
						<label class="text-sm font-semibold text-[#35453b]">
							City
							<select required name="city" class="mt-2 w-full rounded-xl border border-[#d5dbd2] bg-[#fbfcf9] px-4 py-3 text-sm font-normal outline-none focus:border-[#789400]">
								<option value="">Select city</option>
								<option>Karachi</option>
								<option>Other</option>
							</select>
						</label>
						<label class="text-sm font-semibold text-[#35453b] sm:col-span-2">
							Service Required
							<select required name="service" class="mt-2 w-full rounded-xl border border-[#d5dbd2] bg-[#fbfcf9] px-4 py-3 text-sm font-normal outline-none focus:border-[#789400]">
								<option value="">Choose a service</option>
								<option>Litigation [Civil/Criminal/Family]</option>
								<option>Real Estate & SBCA</option>
								<option>SECP Setup</option>
								<option>WeBOC Import/Export</option>
								<option>Tax Filing [FBR/LLC]</option>
								<option>IPO Trademark</option>
							</select>
						</label>
						<label class="text-sm font-semibold text-[#35453b] sm:col-span-2">
							Brief Case Details
							<textarea required name="case-details" rows="4" class="mt-2 w-full resize-y rounded-xl border border-[#d5dbd2] bg-[#fbfcf9] px-4 py-3 text-sm font-normal outline-none focus:border-[#789400]"></textarea>
						</label>
					</div>
					<button type="submit" class="mt-6 w-full rounded-full bg-[#163a2a] px-6 py-3.5 text-sm font-bold text-white">
						Request a consultation ↗
					</button>
					<p class="mt-4 text-center text-xs leading-5 text-[#89938a]">
						This initial enquiry does not create an advocate-client relationship.
					</p>
				</form>
			</section>
			<section class="border-t border-[#dfe3d9] bg-[#fbfcf9] px-5 py-10 lg:px-10"><div class="mx-auto max-w-7xl"><p class="text-sm leading-6 text-[#68736b]">Advocate Jahanzaib is a Karachi-based legal practitioner and corporate consultant serving clients in Karachi and across Pakistan. Website information is general information only, not legal advice, and does not create an advocate-client relationship. Results are not guaranteed.</p><a href="/privacy" class="mt-3 inline-flex text-sm font-bold text-[#547000]">Read our Privacy Policy</a></div></section>
		</main>

		<footer class="border-t border-[#dfe3d9] bg-[#edf1e8]"><div class="mx-auto max-w-7xl px-5 py-12 lg:px-10"><div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]"><div><a href="/" class="flex items-center gap-3 text-sm font-bold text-[#163a2a]"><span class="grid h-9 w-9 place-items-center rounded-full bg-[#163a2a] text-lg text-[#d5e767]">§</span>Advocate Jahanzaib</a><p class="mt-4 max-w-sm text-sm leading-6 text-[#68736b]">Legal Practitioner & Corporate Consultant in Karachi, Sindh, Pakistan.</p><p class="mt-3 text-sm font-semibold text-[#4e5b53]">Address: Karachi, Sindh, Pakistan</p><p class="mt-2 text-sm text-[#68736b]"><a href={phoneHref} class="hover:text-[#163a2a]">{phone}</a> · <a href={`mailto:${email}`} class="hover:text-[#163a2a]">{email}</a></p></div><div class="grid gap-8 text-sm sm:grid-cols-3"><div><p class="font-bold text-[#163a2a]">Legal services</p><p class="mt-3 leading-6 text-[#68736b]">Best Lawyer in Karachi · Civil Lawyer Karachi · Criminal Defense Advocate Pakistan · Family Lawyer Karachi</p></div><div><p class="font-bold text-[#163a2a]">Corporate & tax</p><p class="mt-3 leading-6 text-[#68736b]">SECP Company Setup Karachi · WeBOC Registration Consultant · US LLC Tax Filing Pakistan · FBR Tax Services</p></div><div><p class="font-bold text-[#163a2a]">Property & IP</p><p class="mt-3 leading-6 text-[#68736b]">Property & SBCA Lawyer Karachi · Real Estate Law · IPO Pakistan Trademark · Legal support across Pakistan</p></div></div></div><div class="mt-10 border-t border-[#d5ddd3] pt-6 text-xs leading-6 text-[#77827a]"><p><strong class="text-[#4e5b53]">Legal Disclaimer:</strong> Website information is general information only and is not legal advice. Every matter is fact-specific. Contacting this office or submitting an enquiry does not create an advocate-client relationship until formally agreed in writing. Results are not guaranteed.</p><p class="mt-3">© 2026 Advocate Jahanzaib. All rights reserved. Karachi, Sindh, Pakistan.</p></div></div></footer>
	</div>

	<script define:vars={{ email }}>
		const form = document.getElementById('contact-form');
		if (form) {
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				
				const formData = new FormData(form);
				const fullName = formData.get('full-name');
				const phone = formData.get('phone');
				const emailVal = formData.get('email');
				const city = formData.get('city');
				const service = formData.get('service');
				const caseDetails = formData.get('case-details');
				
				const subject = `Consultation Inquiry: ${service} - ${fullName}`;
				const body = `New Consultation Inquiry:\n\n` +
					`- Full Name: ${fullName}\n` +
					`- Phone Number (WhatsApp): ${phone}\n` +
					`- Email: ${emailVal}\n` +
					`- City: ${city}\n` +
					`- Service Required: ${service}\n\n` +
					`Brief Case Details:\n` +
					`${caseDetails}`;
				
				const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
				window.location.href = mailtoUrl;
			});
		}
	</script>
</Layout>

	