---
/**
 * Mailto-based enquiry form.
 *
 * Current behaviour: opens the visitor's email client with a pre-filled message.
 * No server-side storage, database, or third-party form API is used.
 *
 * Future backend: replace the submit handler with a fetch() to a server endpoint
 * without changing the field names below. Do not place API keys in this component.
 */
import { services } from '../data/services';
import { site, phoneHref, mailHref } from '../data/site';

const { formId = 'contact-form', headingId } = Astro.props as {
	formId?: string;
	headingId?: string;
};
---

<form
	id={formId}
	class="relative rounded-2xl border border-[#e9e6e2] bg-white p-5 shadow-sm sm:p-6"
	data-enquiry="mailto"
	data-practice-email={site.email}
	aria-describedby={headingId ? `${headingId} ${formId}-note ${formId}-fallback ${formId}-status` : `${formId}-note ${formId}-fallback ${formId}-status`}
>
	<div class="grid gap-4 sm:grid-cols-2">
		<label class="text-sm font-semibold text-[#4a4947]" for={`${formId}-full-name`}>
			Full Name
			<input
				id={`${formId}-full-name`}
				required
				name="full-name"
				type="text"
				autocomplete="name"
				maxlength="120"
				class="mt-2 min-h-12 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal focus-visible:border-[#a83009]"
			/>
		</label>
		<label class="text-sm font-semibold text-[#4a4947]" for={`${formId}-phone`}>
			Phone Number (WhatsApp)
			<input
				id={`${formId}-phone`}
				required
				name="phone"
				type="tel"
				inputmode="tel"
				autocomplete="tel"
				maxlength="30"
				placeholder={site.phone}
				class="mt-2 min-h-12 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal focus-visible:border-[#a83009]"
			/>
		</label>
		<label class="text-sm font-semibold text-[#4a4947]" for={`${formId}-email`}>
			Email
			<input
				id={`${formId}-email`}
				required
				name="email"
				type="email"
				autocomplete="email"
				maxlength="254"
				class="mt-2 min-h-12 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal focus-visible:border-[#a83009]"
			/>
		</label>
		<label class="text-sm font-semibold text-[#4a4947]" for={`${formId}-city`}>
			Karachi or elsewhere in Pakistan
			<select
				id={`${formId}-city`}
				required
				name="city"
				class="mt-2 min-h-12 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3.5 text-sm font-normal focus-visible:border-[#a83009]"
			>
				<option value="">Select location</option>
				<option>Karachi</option>
				<option>Elsewhere in Pakistan</option>
			</select>
		</label>
		<label class="text-sm font-semibold text-[#4a4947] sm:col-span-2" for={`${formId}-service`}>
			Service Required
			<select
				id={`${formId}-service`}
				required
				name="service"
				class="mt-2 min-h-12 w-full rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3.5 text-sm font-normal focus-visible:border-[#a83009]"
			>
				<option value="">Choose a service</option>
				{services.map((service) => <option value={service.label}>{service.label}</option>)}
			</select>
		</label>
		<label class="text-sm font-semibold text-[#4a4947] sm:col-span-2" for={`${formId}-case-details`}>
			Brief Case Details
			<textarea
				id={`${formId}-case-details`}
				required
				name="case-details"
				rows="4"
				maxlength="2000"
				class="mt-2 min-h-28 w-full resize-y rounded-xl border border-[#dcdad6] bg-[#fbfaf8] px-4 py-3 text-sm font-normal focus-visible:border-[#a83009]"
			></textarea>
		</label>

		{/* Honeypot — leave empty. Hidden from people and assistive tech; simple bot filter only. */}
		<div class="pointer-events-none absolute -left-[10000px] top-auto h-px w-px overflow-hidden opacity-0" aria-hidden="true">
			<label for={`${formId}-company`}>Company</label>
			<input id={`${formId}-company`} type="text" name="company" tabindex="-1" autocomplete="off" />
		</div>
	</div>

	<p id={`${formId}-note`} class="mt-5 break-words text-xs leading-5 text-[#696764]">
		Submitting opens your email application with a pre-filled message to {site.email}. This website does not store the form on a server. Do not include highly sensitive documents until engagement is agreed.
		{' '}
		<a href="/privacy" class="font-semibold text-[#a83009] hover:underline">Privacy Policy</a>
		{' · '}
		<a href="/terms" class="font-semibold text-[#a83009] hover:underline">Terms of Use</a>
	</p>

	<p id={`${formId}-status`} class="mt-3 min-h-5 text-sm font-semibold text-[#a83009]" role="status" aria-live="polite"></p>

	<div id={`${formId}-fallback`} class="mt-4 min-w-0 rounded-2xl border border-[#e9e6e2] bg-[#f5f2ee] px-4 py-3 text-sm leading-6 text-[#4a4947]">
		<p>
			If the enquiry form does not open your email app, email the practice directly or call us. This website does not store enquiries on a server.
		</p>
		<p class="mt-3 flex min-w-0 flex-wrap gap-x-4 gap-y-2">
			<a
				href={mailHref}
				class="touch-target inline-flex min-h-12 max-w-full items-center break-all font-bold text-[#a83009] hover:underline"
				aria-label={`Email ${site.name} at ${site.email}`}
			>
				Email {site.email}
			</a>
			<a
				href={phoneHref}
				class="touch-target inline-flex min-h-12 items-center font-bold text-[#a83009] hover:underline"
				aria-label={`Call ${site.name} on ${site.phone}`}
			>
				Call {site.phone}
			</a>
		</p>
	</div>

	<noscript>
		<p class="mt-4 rounded-2xl border border-[#faac93] bg-[#fef5f2] px-4 py-3 text-sm leading-6 text-[#4a4947]">
			JavaScript is required to open a pre-filled email from this form. Use the email or phone links above to contact the practice directly.
		</p>
	</noscript>

	<button type="submit" class="mt-4 w-full rounded-full bg-[#0c0c0c] px-6 py-3.5 text-sm font-bold text-white hover:bg-[#252424]">
		Request a consultation ↗
	</button>
	<p class="mt-4 text-center text-xs leading-5 text-[#252424]">
		This initial enquiry does not create an advocate-client relationship. Results are not guaranteed.
	</p>
</form>

<script src="/enquiry-form.js" defer></script>
