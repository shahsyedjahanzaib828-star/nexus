---
import { site, phoneHref, mailHref } from '../data/site';
import { services } from '../data/services';
import { blogPosts } from '../data/blog';

const recentPosts = blogPosts.slice(0, 4);
---

<footer class="border-t border-[#dfe3d9] bg-[#edf1e8]">
	<div class="mx-auto max-w-7xl px-5 py-12 lg:px-10">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.6fr]">
			<div>
				<a href="/" class="flex items-center gap-3 text-sm font-bold text-[#163a2a]">
					<span class="grid h-9 w-9 place-items-center rounded-full bg-[#163a2a] text-lg text-[#d5e767]">§</span>{site.name}
				</a>
				<p class="mt-4 max-w-sm text-sm leading-6 text-[#18231e]">{site.tagline} in {site.city}, {site.region}, {site.country}.</p>
				<p class="mt-3 text-sm font-semibold text-[#4e5b53]">Address: {site.city}, {site.region}, {site.country}</p>
				<p class="mt-2 text-sm text-[#18231e]">
					<a href={phoneHref} class="hover:text-[#163a2a]">{site.phone}</a> · <a href={mailHref} class="hover:text-[#163a2a]">{site.email}</a>
				</p>
			</div>

			<div class="grid gap-8 text-sm sm:grid-cols-3">
				<div>
					<p class="font-bold text-[#163a2a]">Practice areas</p>
					<ul class="mt-3 space-y-2">
						{services.map((service) => (
							<li><a href={`/services/${service.slug}`} class="leading-6 text-[#18231e] hover:text-[#547000]">{service.label}</a></li>
						))}
					</ul>
				</div>
				<div>
					<p class="font-bold text-[#163a2a]">Recent insights</p>
					<ul class="mt-3 space-y-2">
						{recentPosts.map((post) => (
							<li><a href={`/blog/${post.slug}`} class="leading-6 text-[#18231e] hover:text-[#547000]">{post.label}</a></li>
						))}
					</ul>
				</div>
				<div>
					<p class="font-bold text-[#163a2a]">Practice</p>
					<ul class="mt-3 space-y-2">
						<li><a href="/about" class="leading-6 text-[#18231e] hover:text-[#547000]">About the practice</a></li>
						<li><a href="/services" class="leading-6 text-[#18231e] hover:text-[#547000]">All services</a></li>
						<li><a href="/blog" class="leading-6 text-[#18231e] hover:text-[#547000]">Legal insights</a></li>
						<li><a href="/#contact" class="leading-6 text-[#18231e] hover:text-[#547000]">Contact</a></li>
						<li><a href="/privacy" class="leading-6 text-[#18231e] hover:text-[#547000]">Privacy policy</a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-10 border-t border-[#d5ddd3] pt-6 text-xs leading-6 text-[#18231e]">
			<p><strong class="text-[#4e5b53]">Legal Disclaimer:</strong> Website information is general information only and is not legal advice. Every matter is fact-specific. Contacting this office or submitting an enquiry does not create an advocate-client relationship until formally agreed in writing. Results are not guaranteed.</p>
			<p class="mt-3">© {new Date().getFullYear()} {site.name}. All rights reserved. {site.city}, {site.region}, {site.country}.</p>
		</div>
	</div>
</footer>
