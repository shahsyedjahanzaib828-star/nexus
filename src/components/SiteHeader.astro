---
import { site, phoneHref, whatsappHref } from '../data/site';
import { services } from '../data/services';

const { current } = Astro.props as { current?: 'home' | 'services' | 'blog' | 'about' };

const links = [
	{ href: '/about', label: 'About', key: 'about' },
	{ href: '/blog', label: 'Blog', key: 'blog' }
];
const linkClass = (key: string) => (current === key ? 'text-[#a83009]' : 'hover:text-[#0c0c0c]');
---

<header class="sticky top-0 z-40 border-b border-[#e9e6e2] bg-[#fbfaf8]/95 backdrop-blur">
	<div class="hidden border-b border-[#e9e6e2] bg-[#0c0c0c] text-[#e9e6e2] lg:block">
		<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-2 text-xs font-semibold lg:px-10">
			<p>{site.city} · {site.region} · {site.country}</p>
			<div class="flex items-center gap-5">
				<a href={phoneHref} class="min-h-0 text-[#e9e6e2] hover:text-white">{site.phone}</a>
				<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="min-h-0 text-[#f45a27] hover:text-white">WhatsApp</a>
				<a href="/#contact" class="min-h-0 text-[#e9e6e2] hover:text-white">Enquire</a>
			</div>
		</div>
	</div>

	<div class="mx-auto flex min-w-0 max-w-7xl flex-wrap items-center justify-between gap-x-2 gap-y-2 px-3 py-3 sm:px-5 sm:py-4 lg:px-10 lg:py-5">
		<a href="/" aria-label={`${site.name} home`} class="flex min-w-0 flex-1 items-center gap-2 sm:flex-none sm:gap-3">
			<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#0c0c0c] text-lg text-[#f45a27] sm:h-10 sm:w-10 sm:text-xl">§</span>
			<span class="min-w-0 text-sm font-bold leading-tight">
				<span class="block truncate">{site.name}</span>
				<span class="mt-0.5 hidden truncate text-[10px] font-medium uppercase tracking-[0.15em] text-[#252424] sm:block">{site.tagline}</span>
			</span>
		</a>

		<nav class="hidden items-center gap-7 text-sm font-semibold text-[#696764] lg:flex" aria-label="Main navigation">
			{current !== 'home' && <a href="/" class="hover:text-[#0c0c0c]">Home</a>}

			<div class="group relative">
				<a href="/services" class:list={['gap-1', linkClass('services')]} aria-haspopup="true">
					Practice Areas <span aria-hidden="true" class="text-[10px]">▾</span>
				</a>
				<div class="invisible absolute left-1/2 top-full z-30 w-[38rem] -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
					<div class="rounded-2xl border border-[#e9e6e2] bg-white p-4 shadow-xl">
						<p class="px-2 pb-3 text-xs font-bold uppercase tracking-[0.16em] text-[#a83009]">Choose a practice area</p>
						<ul class="grid grid-cols-2 gap-1">
							{services.map((service) => (
								<li>
									<a href={`/services/${service.slug}`} class="flex w-full items-start gap-3 rounded-xl px-3 py-3 text-[#696764] hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">
										<span class="mt-0.5 text-base text-[#a83009]" aria-hidden="true">{service.icon}</span>
										<span>
											<span class="block text-sm font-bold text-[#0c0c0c]">{service.label}</span>
											<span class="mt-1 block text-xs font-normal leading-4">{service.heading}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
						<a href="/services" class="mt-2 w-full justify-center rounded-xl bg-[#f5f2ee] px-3 py-3 text-sm font-bold text-[#0c0c0c]">
							View all practice areas ↗
						</a>
					</div>
				</div>
			</div>

			{links.map((link) => <a href={link.href} class={linkClass(link.key)}>{link.label}</a>)}
			<a href="/#contact" class="hover:text-[#0c0c0c]">Contact</a>
		</nav>

		<div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
			<details class="lg:hidden">
		<summary class="touch-target list-none rounded-full border border-[#c4c2be] px-2.5 py-2 text-sm font-bold text-[#0c0c0c] sm:px-4 sm:py-2.5">
					<span aria-hidden="true">☰</span><span class="sr-only">Open navigation menu</span>
				</summary>
				<nav class="absolute left-0 right-0 top-full z-50 w-full max-w-full px-3 sm:px-5" aria-label="Mobile navigation">
					<div class="mx-auto grid max-h-[min(70dvh,36rem)] w-full max-w-7xl gap-1 overflow-x-hidden overflow-y-auto rounded-2xl border border-[#e9e6e2] bg-white p-2 text-sm font-semibold text-[#696764] shadow-xl">
						<a href="/" class="w-full rounded-xl px-4 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">Home</a>
						{services.map((service) => (
							<a href={`/services/${service.slug}`} class="w-full rounded-xl px-4 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">{service.label}</a>
						))}
						<a href="/about" class="w-full rounded-xl px-4 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">About</a>
						<a href="/blog" class="w-full rounded-xl px-4 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">Blog</a>
						<a href="/#contact" class="w-full rounded-xl px-4 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">Contact</a>
					</div>
				</nav>
			</details>

			<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="touch-target hidden min-h-0 whitespace-nowrap rounded-full bg-[#0c0c0c] px-3 py-2 text-xs font-bold text-white hover:-translate-y-0.5 sm:inline-flex sm:px-4 sm:py-2.5 sm:text-sm">
				WhatsApp <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</header>
