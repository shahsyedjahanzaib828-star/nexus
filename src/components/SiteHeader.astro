---
import { site, phoneHref, whatsappHref } from '../data/site';
import {
	practiceAreaServices,
	businessServices,
	insightNavPosts,
	navBusinessLabels,
	isPracticeAreaSlug,
	isBusinessServiceSlug,
	isInsightSlug
} from '../data/navigation';

const { current } = Astro.props as { current?: 'home' | 'services' | 'blog' | 'about' | 'contact' };

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeServiceSlug =
	pathname.startsWith('/services/') && pathname !== '/services'
		? pathname.slice('/services/'.length)
		: '';
const activeBlogSlug =
	pathname.startsWith('/blog/') && pathname !== '/blog' ? pathname.slice('/blog/'.length) : '';

const linkClass = (key: string) => (current === key ? 'text-[#a83009]' : 'hover:text-[#0c0c0c]');
const menuClass = (active: boolean) =>
	active ? 'text-[#a83009]' : 'cursor-pointer list-none gap-1 hover:text-[#0c0c0c]';

const practiceMenuOpen = isPracticeAreaSlug(activeServiceSlug);
const businessMenuOpen = isBusinessServiceSlug(activeServiceSlug);
const insightsMenuOpen = current === 'blog' || isInsightSlug(activeBlogSlug);
const latestInsight = insightNavPosts[0];
---

<header class="relative sticky top-0 z-40 border-b border-[#e9e6e2] bg-[#fbfaf8]/95 backdrop-blur">
	<div class="mx-auto flex min-w-0 max-w-7xl items-center justify-between gap-x-2 gap-y-2 px-3 py-2 sm:px-5 sm:py-2.5 lg:px-8">
		<a href="/" aria-label={`${site.name} home`} class="flex min-w-0 flex-1 items-center gap-2 sm:flex-none sm:gap-2.5">
			<span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#0c0c0c] text-base text-[#f45a27]">§</span>
			<span class="min-w-0 text-sm font-bold leading-tight">
				<span class="block truncate">{site.name}</span>
				<span class="mt-0.5 hidden truncate text-[10px] font-medium uppercase tracking-[0.14em] text-[#252424] lg:block">{site.tagline}</span>
			</span>
		</a>

		<nav class="hidden min-w-0 items-center gap-3 text-[11px] font-bold uppercase tracking-[0.08em] text-[#696764] xl:gap-4 lg:flex" aria-label="Main navigation">
			<a href="/about" class={linkClass('about')}>About</a>

			<details class="nav-dropdown relative" open={practiceMenuOpen ? true : undefined}>
				<summary class:list={['touch-target min-h-12', menuClass(practiceMenuOpen)]}>
					Practice Areas <span aria-hidden="true" class="text-[9px]">▾</span>
				</summary>
				<div class="nav-panel absolute left-0 top-full z-30 w-[20rem] max-w-[calc(100vw-2rem)] pt-1.5">
					<div class="rounded-xl border border-[#e9e6e2] bg-white p-2.5 shadow-xl">
						<ul class="space-y-0.5">
							{practiceAreaServices.map((service) => (
								<li>
									<a
										href={`/services/${service.slug}`}
										class:list={[
											'touch-target flex min-h-12 w-full items-center rounded-lg px-2.5 py-2 normal-case tracking-normal hover:bg-[#f5f2ee]',
											activeServiceSlug === service.slug ? 'bg-[#fef5f2] text-[#0c0c0c]' : 'text-[#696764] hover:text-[#0c0c0c]'
										]}
									>
										<span class="text-sm font-bold text-[#0c0c0c]">{service.label}</span>
									</a>
								</li>
							))}
						</ul>
						<a href="/services" class="touch-target mt-1.5 block rounded-lg bg-[#f5f2ee] px-2.5 py-2.5 text-center text-xs font-bold normal-case tracking-normal text-[#0c0c0c]">
							View all practice areas ↗
						</a>
					</div>
				</div>
			</details>

			<details class="nav-dropdown relative" open={businessMenuOpen ? true : undefined}>
				<summary class:list={['touch-target min-h-12', menuClass(businessMenuOpen)]}>
					Business Services <span aria-hidden="true" class="text-[9px]">▾</span>
				</summary>
				<div class="nav-panel absolute left-1/2 top-full z-30 w-[22rem] max-w-[calc(100vw-2rem)] -translate-x-1/2 pt-1.5">
					<div class="rounded-xl border border-[#e9e6e2] bg-white p-2.5 shadow-xl">
						<ul class="space-y-0.5">
							{businessServices.map((service) => (
								<li>
									<a
										href={`/services/${service.slug}`}
										class:list={[
											'touch-target flex min-h-12 w-full items-center rounded-lg px-2.5 py-2 normal-case tracking-normal hover:bg-[#f5f2ee]',
											activeServiceSlug === service.slug ? 'bg-[#fef5f2] text-[#0c0c0c]' : 'text-[#696764] hover:text-[#0c0c0c]'
										]}
									>
										<span class="text-sm font-bold text-[#0c0c0c]">{navBusinessLabels[service.slug as keyof typeof navBusinessLabels]}</span>
									</a>
								</li>
							))}
						</ul>
						<a href="/services" class="touch-target mt-1.5 block rounded-lg bg-[#f5f2ee] px-2.5 py-2.5 text-center text-xs font-bold normal-case tracking-normal text-[#0c0c0c]">
							View all business services ↗
						</a>
					</div>
				</div>
			</details>

			<details class="nav-dropdown relative" open={insightsMenuOpen ? true : undefined}>
				<summary class:list={['touch-target min-h-12', menuClass(insightsMenuOpen)]}>
					Insights <span aria-hidden="true" class="text-[9px]">▾</span>
				</summary>
				<div class="nav-panel absolute right-0 top-full z-30 w-[22rem] max-w-[calc(100vw-2rem)] pt-1.5">
					<div class="rounded-xl border border-[#e9e6e2] bg-white p-2.5 shadow-xl">
						<ul class="space-y-0.5">
							{insightNavPosts.map((post) => (
								<li>
									<a
										href={`/blog/${post.slug}`}
										class:list={[
											'touch-target block rounded-lg px-2.5 py-2 normal-case tracking-normal hover:bg-[#f5f2ee]',
											activeBlogSlug === post.slug ? 'bg-[#fef5f2] text-[#0c0c0c]' : 'text-[#696764] hover:text-[#0c0c0c]'
										]}
									>
										<span class="block text-xs font-bold text-[#0c0c0c]">{post.navLabel}</span>
										<span class="mt-0.5 block text-[11px] font-normal leading-4 text-[#696764]">{post.title}</span>
									</a>
								</li>
							))}
						</ul>
						<a href="/blog" class="touch-target mt-1.5 block rounded-lg bg-[#f5f2ee] px-2.5 py-2.5 text-center text-xs font-bold normal-case tracking-normal text-[#0c0c0c]">
							View all insights ↗
						</a>
					</div>
				</div>
			</details>

			<a href="/contact" class={linkClass('contact')}>Contact</a>
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				class="touch-target min-h-12 whitespace-nowrap rounded-full border border-[#c4c2be] px-3 py-2.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#0c0c0c] hover:border-[#0c0c0c] hover:text-[#0c0c0c]"
			>
				WhatsApp <span aria-hidden="true">↗</span>
			</a>
			<a href="/contact" class="touch-target min-h-12 rounded-full bg-[#0c0c0c] px-3 py-2.5 text-[11px] font-bold uppercase tracking-[0.08em] text-white hover:bg-[#252424] xl:px-4">
				Enquire
			</a>
		</nav>

		<div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
			{/*
			  Mobile menu: keep the panel out of layout when closed.
			  Absolute children of closed <details> can still paint/measure in some engines and inflate scrollWidth at 320px.
			*/}
			<details class="group lg:hidden">
				<summary class="touch-target list-none rounded-full border border-[#c4c2be] px-2.5 py-2 text-sm font-bold text-[#0c0c0c] sm:px-4 sm:py-2.5">
					<span aria-hidden="true">☰</span><span class="sr-only">Open navigation menu</span>
				</summary>
				<nav class="absolute inset-x-0 top-full z-50 hidden max-w-full px-3 group-open:block sm:px-5" aria-label="Mobile navigation">
					<div class="mx-auto max-h-[min(75dvh,36rem)] w-full min-w-0 max-w-full overflow-x-hidden overflow-y-auto rounded-xl border border-[#e9e6e2] bg-white p-2 text-sm font-semibold text-[#696764] shadow-xl">
						<a href="/" class="touch-target w-full max-w-full rounded-lg px-3 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">Home</a>
						<a href="/about" class="touch-target w-full max-w-full rounded-lg px-3 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">About</a>

						<details class="min-w-0 rounded-lg border border-[#e9e6e2]">
							<summary class="touch-target flex min-h-12 min-w-0 list-none items-center justify-between gap-2 px-3 py-2 font-bold text-[#0c0c0c]">
								<span class="min-w-0 truncate">Practice Areas</span> <span aria-hidden="true" class="shrink-0 text-[#a83009]">+</span>
							</summary>
							<div class="min-w-0 space-y-0.5 px-1 pb-2">
								{practiceAreaServices.map((service) => (
									<a href={`/services/${service.slug}`} class="touch-target block max-w-full rounded-lg px-3 py-2.5 break-words hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">{service.label}</a>
								))}
								<a href="/services" class="touch-target block max-w-full rounded-lg px-3 py-2.5 text-[#a83009]">View all practice areas ↗</a>
							</div>
						</details>

						<details class="mt-1 min-w-0 rounded-lg border border-[#e9e6e2]">
							<summary class="touch-target flex min-h-12 min-w-0 list-none items-center justify-between gap-2 px-3 py-2 font-bold text-[#0c0c0c]">
								<span class="min-w-0 truncate">Business Services</span> <span aria-hidden="true" class="shrink-0 text-[#a83009]">+</span>
							</summary>
							<div class="min-w-0 space-y-0.5 px-1 pb-2">
								{businessServices.map((service) => (
									<a href={`/services/${service.slug}`} class="touch-target block max-w-full rounded-lg px-3 py-2.5 break-words hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">
										{navBusinessLabels[service.slug as keyof typeof navBusinessLabels]}
									</a>
								))}
								<a href="/services" class="touch-target block max-w-full rounded-lg px-3 py-2.5 text-[#a83009]">View all business services ↗</a>
							</div>
						</details>

						<details class="mt-1 min-w-0 rounded-lg border border-[#e9e6e2]">
							<summary class="touch-target flex min-h-12 min-w-0 list-none items-center justify-between gap-2 px-3 py-2 font-bold text-[#0c0c0c]">
								<span class="min-w-0 truncate">Insights</span> <span aria-hidden="true" class="shrink-0 text-[#a83009]">+</span>
							</summary>
							<div class="min-w-0 space-y-0.5 px-1 pb-2">
								{latestInsight && (
									<a href={`/blog/${latestInsight.slug}`} class="touch-target block max-w-full rounded-lg px-3 py-2.5 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">Latest insight</a>
								)}
								<a href="/blog" class="touch-target block max-w-full rounded-lg px-3 py-2.5 text-[#a83009]">View all insights ↗</a>
							</div>
						</details>

						<a href="/contact" class="touch-target mt-1 block w-full max-w-full rounded-lg px-3 py-3 hover:bg-[#f5f2ee] hover:text-[#0c0c0c]">Contact</a>
						<a href={phoneHref} class="touch-target mt-1 block w-full max-w-full rounded-lg border border-[#e9e6e2] px-3 py-3 text-center font-bold text-[#0c0c0c]">Call {site.phone}</a>
					</div>
				</nav>
			</details>
		</div>
	</div>
</header>
