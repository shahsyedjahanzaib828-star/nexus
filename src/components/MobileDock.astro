---
import { site, phoneHref, whatsappHref } from '../data/site';
---

<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-[#dfe3d9] bg-[#f6f7f2]/95 px-3 py-2 backdrop-blur lg:hidden" aria-label="Mobile contact">
	<div class="mx-auto grid max-w-lg grid-cols-2 gap-2">
		<a href={phoneHref} class="justify-center rounded-full border border-[#b8c3b6] bg-white px-3 py-2.5 text-sm font-bold text-[#163a2a]">
			Call {site.phone}
		</a>
		<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="justify-center rounded-full bg-[#163a2a] px-3 py-2.5 text-sm font-bold text-white">
			WhatsApp ↗
		</a>
	</div>
</nav>
