---
import { site, phoneHref, whatsappHref } from '../data/site';
---

<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-[#e9e6e2] bg-[#fbfaf8]/95 px-3 py-2 backdrop-blur lg:hidden" aria-label="Mobile contact">
	<div class="mx-auto grid max-w-lg grid-cols-2 gap-2">
		<a href={phoneHref} class="justify-center rounded-full border border-[#c4c2be] bg-white px-3 py-2.5 text-sm font-bold text-[#0c0c0c]">
			Call {site.phone}
		</a>
		<a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="justify-center rounded-full bg-[#0c0c0c] px-3 py-2.5 text-sm font-bold text-white">
			WhatsApp ↗
		</a>
	</div>
</nav>
