---
import '../styles/global.css';
import MobileDock from '../components/MobileDock.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const title = 'Lawyer in Karachi | Civil, Criminal, Family & Corporate Law';
const description = `${site.city} legal practice for civil, criminal and family litigation, SECP company registration, FBR tax filing, property matters and trademark protection.`;
const siteUrl = site.url;
const serviceCities = ['Karachi', 'Hyderabad', 'Sukkur', 'Lahore', 'Islamabad', 'Rawalpindi', 'Faisalabad', 'Multan', 'Gujranwala', 'Sialkot', 'Bahawalpur', 'Peshawar', 'Quetta', 'Abbottabad', 'Muzaffarabad', 'Gilgit'];

// LegalService is a subtype of LocalBusiness, so a single node carries the local
// signals instead of splitting them across competing entities.
const legalServiceSchema = {
	'@type': 'LegalService',
	'@id': `${siteUrl}/#legal-service`,
	'name': site.name,
	'alternateName': `${site.name} | ${site.tagline}`,
	'description': description,
	'url': `${siteUrl}/`,
	'telephone': '+92' + site.phone.slice(1),
	'email': site.email,
	'currenciesAccepted': 'PKR',
	'paymentAccepted': 'Cash, Bank Transfer',
	'areaServed': [
		...serviceCities.map((name) => ({ '@type': 'City', name })),
		{ '@type': 'State', name: site.region },
		{ '@type': 'Country', name: site.country }
	],
	'address': {
		'@type': 'PostalAddress',
		'addressLocality': site.city,
		'addressRegion': site.region,
		'addressCountry': 'PK'
	},
	'geo': { '@type': 'GeoCoordinates', latitude: 24.8607, longitude: 67.0011 },
	'serviceType': services.map((service) => service.label),
	'priceRange': '$$',
	'knowsAbout': ['Civil Litigation', 'Criminal Defense', 'Family Law', 'Corporate Law', 'Tax Filing', 'Real Estate Law', 'Trademark Registration'],
	'hasOfferCatalog': {
		'@type': 'OfferCatalog',
		'name': 'Legal and corporate services',
		'itemListElement': services.map((service) => ({
			'@type': 'Offer',
			itemOffered: { '@type': 'Service', name: service.heading, url: `${siteUrl}/services/${service.slug}` }
		}))
	}
};

const websiteSchema = {
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	'url': `${siteUrl}/`,
	'name': site.name,
	'inLanguage': 'en-PK',
	'publisher': { '@id': `${siteUrl}/#legal-service` }
};

const professionalProfileSchema = {
	'@type': 'Person',
	'@id': `${siteUrl}/#professional`,
	'name': 'Jahanzaib',
	'jobTitle': site.tagline,
	'url': `${siteUrl}/about`,
	'worksFor': { '@id': `${siteUrl}/#legal-service` },
	'areaServed': { '@type': 'Country', name: site.country }
};

const {
	title: pageTitle = title,
	description: pageDescription = description,
	canonical,
	schema = {},
	type = 'website',
	ogImage = '/og/home.png',
	ogImageAlt = `${site.name} in ${site.city}`,
	breadcrumbs
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const pageSchema = (Array.isArray(schema?.['@graph']) ? schema['@graph'] : [schema]).map(({ '@context': _context, ...entry }) => entry);

const crumbTrail = breadcrumbs ?? [{ name: 'Home', href: '/' }];
const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	'itemListElement': crumbTrail.map((crumb: { name: string; href: string }, index: number) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: crumb.name,
		item: new URL(crumb.href, siteUrl).href
	}))
};

const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		legalServiceSchema,
		professionalProfileSchema,
		websiteSchema,
		breadcrumbSchema,
		...pageSchema.filter((entry) => Object.keys(entry).length > 0)
	]
};
---

<!doctype html>
<html lang="en-PK">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="theme-color" content="#163a2a" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content={site.name} />
		<meta name="format-detection" content="telephone=yes" />
		<meta name="google-site-verification" content="eXruG7GBHJZ1TEA6gMB9KzhHXPKocTf_JW8fPKEybIw" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content={site.name} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en_PK" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<title>{pageTitle}</title>
		<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
	</head>
	<body class="overflow-x-hidden pb-20 lg:pb-0">
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />
		<MobileDock />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: hidden;
	}
</style>
