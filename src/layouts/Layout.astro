---
import '../styles/global.css';
import MobileDock from '../components/MobileDock.astro';
import {
	site,
	absoluteUrl,
	entityIds,
	practitioner,
	organization,
	locationAddress,
	areaServedNodes,
	withOptionalFields
} from '../data/site';
import { services } from '../data/services';
import { contentSecurityPolicyMeta } from '../data/security';

const defaultTitle = 'Lawyer in Karachi | FBR Tax Filing, Litigation & Corporate Law';
const defaultDescription = `${site.city} lawyer for FBR return filing, civil, criminal and family litigation, SECP company registration, property matters and trademark protection.`;
const siteUrl = site.url;

const {
	title: pageTitle = defaultTitle,
	description: pageDescription = defaultDescription,
	canonical,
	schema = {},
	type = 'website',
	ogImage = '/og/home.png',
	ogImageAlt = `${site.name} in ${site.city}`,
	breadcrumbs,
	/**
	 * Core LegalService + Person + WebSite nodes use stable @ids.
	 * Default true so article author/publisher and service provider refs resolve on-page.
	 */
	includePracticeEntity = true,
	publishedTime,
	modifiedTime,
	robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
	noCanonical = false
} = Astro.props;

const canonicalUrl = absoluteUrl(canonical ? new URL(canonical, siteUrl).pathname : Astro.url.pathname);
const ogImageUrl = new URL(ogImage, siteUrl).href;
const pageSchema = (Array.isArray(schema?.['@graph']) ? schema['@graph'] : [schema]).map(({ '@context': _context, ...entry }) => entry);

const crumbTrail = breadcrumbs ?? [{ name: 'Home', href: '/' }];
const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	'itemListElement': crumbTrail.map((crumb: { name: string; href: string }, index: number) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: crumb.name,
		item: absoluteUrl(crumb.href)
	}))
};

// LegalService is the practice entity (@id …/#legal-service). City-level address only.
const legalServiceSchema = withOptionalFields(
	{
		'@type': 'LegalService',
		'@id': entityIds.organization,
		'name': organization.name,
		'alternateName': organization.alternateName,
		'description': organization.description,
		'url': absoluteUrl('/'),
		'telephone': organization.telephone,
		'email': organization.email,
		'areaServed': areaServedNodes(),
		'address': locationAddress(),
		'serviceType': services.map((service) => service.label),
		'knowsAbout': [...organization.knowsAbout],
		'hasOfferCatalog': {
			'@type': 'OfferCatalog',
			'name': 'Legal and corporate services',
			'itemListElement': services.map((service) => ({
				'@type': 'Offer',
				itemOffered: {
					'@type': 'Service',
					name: service.heading,
					url: absoluteUrl(`/services/${service.slug}`)
				}
			}))
		},
		'employee': { '@id': entityIds.person }
	},
	{
		sameAs: organization.sameAs
	}
);

const websiteSchema = {
	'@type': 'WebSite',
	'@id': entityIds.website,
	'url': absoluteUrl('/'),
	'name': site.name,
	'description': organization.description,
	'inLanguage': 'en-PK',
	'publisher': { '@id': entityIds.organization },
	'about': { '@id': entityIds.organization }
};

// Person uses only the verified given name — do not invent a fuller legal name.
const professionalProfileSchema = withOptionalFields(
	{
		'@type': 'Person',
		'@id': entityIds.person,
		'name': practitioner.name,
		'givenName': practitioner.givenName,
		'jobTitle': practitioner.jobTitle,
		'description': practitioner.description,
		'url': absoluteUrl(practitioner.path),
		'worksFor': { '@id': entityIds.organization },
		'areaServed': areaServedNodes(),
		'knowsAbout': [...organization.knowsAbout]
	},
	{
		image: practitioner.image ? absoluteUrl(practitioner.image) : '',
		sameAs: practitioner.sameAs
	}
);

const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		...(includePracticeEntity ? [legalServiceSchema, professionalProfileSchema, websiteSchema] : []),
		breadcrumbSchema,
		...pageSchema.filter((entry) => Object.keys(entry).length > 0)
	]
};
---

<!doctype html>
<html lang="en-PK" class="max-w-full overflow-x-hidden">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="Content-Security-Policy" content={contentSecurityPolicyMeta} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="theme-color" content="#f45a27" />
		<link rel="preload" href="/fonts/work-sans-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content={site.name} />
		<meta name="format-detection" content="telephone=yes" />
		<meta name="google-site-verification" content="eXruG7GBHJZ1TEA6gMB9KzhHXPKocTf_JW8fPKEybIw" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="robots" content={robots} />
		<meta name="author" content={type === 'article' ? practitioner.name : site.name} />
		{!noCanonical && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={noCanonical ? siteUrl : canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en_PK" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<title>{pageTitle}</title>
		<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
	</head>
	<body class="max-w-full overflow-x-hidden bg-neutral-25 pb-20 font-sans text-neutral-800 lg:pb-0">
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />
		<MobileDock />
	</body>
</html>
