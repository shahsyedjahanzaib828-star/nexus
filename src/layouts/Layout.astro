---
import '../styles/global.css';

const title = 'Jahanzaib Legal Services | Civil, Criminal, Family and Corporate Law in Karachi';
const description = 'Jahanzaib Legal Practice provides civil, criminal, family and corporate legal services in Karachi, including litigation, SECP registration, tax compliance, property law and trademarks.';
const siteUrl = 'https://nexus-alpha-ten-66.vercel.app';
const serviceCities = ['Karachi', 'Hyderabad', 'Sukkur', 'Lahore', 'Islamabad', 'Rawalpindi', 'Faisalabad', 'Multan', 'Gujranwala', 'Sialkot', 'Bahawalpur', 'Peshawar', 'Quetta', 'Abbottabad', 'Muzaffarabad', 'Gilgit'];

const legalServiceSchema = {
	'@type': 'LegalService',
	'@id': `${siteUrl}/#legal-service`,
	'name': 'Jahanzaib Legal Services',
	'alternateName': 'Jahanzaib Legal Practice | Legal Practitioner & Corporate Consultant',
	'description': description,
	'url': `${siteUrl}/`,
	'telephone': '+923343108863',
	'email': 'shahsyedjahanzaib828@gmail.com',
	'currenciesAccepted': 'PKR',
	'paymentAccepted': 'Cash, Bank Transfer',
	'areaServed': [
		...serviceCities.map((name) => ({ '@type': 'City', name })),
		{ '@type': 'State', name: 'Sindh' },
		{ '@type': 'Country', name: 'Pakistan' }
	],
	'address': {
		'@type': 'PostalAddress',
		'addressLocality': 'Karachi',
		'addressRegion': 'Sindh',
		'addressCountry': 'PK'
	},
	'serviceType': ['SECP Company Registration', 'FBR Tax Compliance', 'IPO Trademark', 'WeBOC Registration', 'Civil Litigation', 'Corporate Litigation'],
	'priceRange': '$$',
	'knowsAbout': ['Civil Litigation', 'Criminal Defense', 'Family Law', 'Corporate Law', 'Tax Filing', 'Real Estate Law', 'Trademark Registration']
};

const websiteSchema = {
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	'url': `${siteUrl}/`,
	'name': 'Jahanzaib Legal Practice',
	'publisher': { '@id': `${siteUrl}/#legal-service` },
	'potentialAction': {
		'@type': 'SearchAction',
		'target': `${siteUrl}/blog?q={search_term_string}`,
		'query-input': 'required name=search_term_string'
	}
};

const localBusinessSchema = {
	'@type': 'LocalBusiness',
	'@id': `${siteUrl}/#local-business`,
	'name': 'Jahanzaib Legal Services',
	'url': `${siteUrl}/`,
	'telephone': '+923343108863',
	'email': 'shahsyedjahanzaib828@gmail.com',
	'address': legalServiceSchema.address,
	'areaServed': legalServiceSchema.areaServed,
	'hasOfferCatalog': {
		'@type': 'OfferCatalog',
		'name': 'Legal and corporate services',
		'itemListElement': legalServiceSchema.serviceType.map((service) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service } }))
	}
};

const professionalProfileSchema = {
	'@type': 'Person',
	'@id': `${siteUrl}/#professional`,
	'name': 'Jahanzaib',
	'jobTitle': 'Legal Practitioner & Corporate Consultant',
	'url': `${siteUrl}/`,
	'worksFor': { '@id': `${siteUrl}/#legal-service` },
	'areaServed': { '@type': 'Country', name: 'Pakistan' }
};

const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'itemListElement': [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` }]
};

const { title: pageTitle = title, description: pageDescription = description, canonical, schema = {}, type = 'website', ogImage = '/og/home.svg', ogImageAlt = 'Jahanzaib legal services in Karachi' } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const pageSchema = (Array.isArray(schema?.['@graph']) ? schema['@graph'] : [schema]).map(({ '@context': _context, ...entry }) => entry);
const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [legalServiceSchema, localBusinessSchema, professionalProfileSchema, websiteSchema, { ...breadcrumbSchema, itemListElement: [{ ...breadcrumbSchema.itemListElement[0] }, ...(canonicalUrl !== `${siteUrl}/` ? [{ '@type': 'ListItem', position: 2, name: pageTitle, item: canonicalUrl }] : [])] }, ...pageSchema.filter((entry) => Object.keys(entry).length > 0)]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="google-site-verification" content="eXruG7GBHJZ1TEA6gMB9KzhHXPKocTf_JW8fPKEybIw" />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="keywords" content="Civil, Criminal and Family Law Services in Karachi, Civil Lawyer Karachi, Criminal Defense Advocate Pakistan, Family Lawyer Karachi, WeBOC Registration Consultant, SECP Company Setup Karachi, US LLC Tax Filing Pakistan, Property & SBCA Lawyer Karachi" />
		<meta name="author" content="Jahanzaib Legal Services" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en-PK" href={canonicalUrl} />
		<link rel="alternate" hreflang="ur-PK" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<meta property="og:site_name" content="Jahanzaib Legal Services" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="en_PK" />
		<meta property="og:locale:alternate" content="ur_PK" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<title>{pageTitle}</title>
		<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}></script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
